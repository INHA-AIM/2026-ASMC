<launch>
  <!-- rostest of asmc_lidar_shadow_node with synthetic inputs only: no driver,
       bridge, camera or inference node. The python test node publishes the
       sensor and camera topics and checks the /asmc_lidar/shadow/* outputs. -->
  <arg name="pipeline_config" default="$(find asmc_lidar)/config/shadow_pipeline.yaml"/>
  <!-- Camera calibration data of the sibling asmc_camera source package (data only;
       CMake registers this test only when the file exists). -->
  <arg name="camera_calibration_config" default="$(find asmc_lidar)/../asmc_camera/config/cameras_v3.yaml"/>

  <node pkg="asmc_lidar" type="asmc_lidar_shadow_node" name="asmc_lidar_shadow" output="screen">
    <param name="pipeline_config" value="$(arg pipeline_config)"/>
    <param name="package_dir" value="$(find asmc_lidar)"/>
    <param name="camera_calibration_config" value="$(arg camera_calibration_config)"/>
    <param name="enable_camera_fusion" value="true"/>
    <param name="lidar_level_roll" value="true"/>
    <param name="publish_tf" value="true"/>
  </node>

  <test test-name="shadow_node" pkg="asmc_lidar" type="shadow_node_test.py" name="shadow_node_test"
        time-limit="180">
    <param name="node_name" value="/asmc_lidar_shadow"/>
    <param name="pipeline_config" value="$(arg pipeline_config)"/>
    <param name="camera_calibration_config" value="$(arg camera_calibration_config)"/>
    <param name="mount_config" value="$(find asmc_lidar)/config/autonav_v3.yaml"/>
    <param name="expect_tf" value="true"/>
  </test>
</launch>
