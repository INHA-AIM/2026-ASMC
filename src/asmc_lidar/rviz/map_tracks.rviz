Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Enabled: true
  Global Options:
    Background Color: 15; 18; 24
    Fixed Frame: map
    Frame Rate: 20
  Displays:
    - Class: rviz/Axes
      Name: Map origin
      Enabled: true
      Reference Frame: map
      Length: 2
      Radius: 0.08
    - Class: rviz/MarkerArray
      Name: Map tracks observed green predicted orange
      Enabled: true
      Marker Topic: /lidar_candidate/unified/map_tracks
      Queue Size: 1
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 45
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.85
      Yaw: 0
