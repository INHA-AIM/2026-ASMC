Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Enabled: true
  Global Options:
    Background Color: 15; 18; 24
    Fixed Frame: ground_comparison
    Frame Rate: 20
  Displays:
    - Class: rviz/Grid
      Name: Review-only XY grid
      Enabled: true
      Alpha: 0.25
      Color: 100; 100; 100
      Cell Size: 1
      Plane: XY
      Plane Cell Count: 100
    - Class: rviz/PointCloud2
      Name: Jaeho reference (RANSAC)
      Enabled: true
      Topic: /lidar_candidate/ground_compare/jaeho
      Color Transformer: RGB8
      Size (m): 0.10
      Style: Points
      Queue Size: 1
    - Class: rviz/PointCloud2
      Name: Patchwork++
      Enabled: true
      Topic: /lidar_candidate/ground_compare/patchwork
      Color Transformer: RGB8
      Size (m): 0.10
      Style: Points
      Queue Size: 1
    - Class: rviz/PointCloud2
      Name: VLP16 linefit
      Enabled: true
      Topic: /lidar_candidate/ground_compare/linefit
      Color Transformer: RGB8
      Size (m): 0.10
      Style: Points
      Queue Size: 1
    - Class: rviz/MarkerArray
      Name: Method labels
      Enabled: true
      Marker Topic: /lidar_candidate/ground_compare/labels
      Queue Size: 1
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 115
      Focal Point:
        X: 12
        Y: 0
        Z: 0
      Pitch: 0.9
      Yaw: 0.1
