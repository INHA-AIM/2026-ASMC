Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Enabled: true
  Global Options:
    Background Color: 15; 18; 24
    Fixed Frame: base_link
    Frame Rate: 20
  Displays:
    - Class: rviz/Axes
      Name: Rear axle base_link
      Enabled: true
      Reference Frame: base_link
      Length: 2
      Radius: 0.06
    - Class: rviz/PointCloud2
      Name: Nonground (not confirmed objects)
      Enabled: true
      Topic: /lidar_candidate/unified/nonground
      Color Transformer: FlatColor
      Color: 215; 215; 215
      Style: Flat Squares
      Size (m): 0.065
      Alpha: 0.8
      Queue Size: 1
      Decay Time: 0
    - Class: rviz/PointCloud2
      Name: Structure evidence (not suppressed)
      Enabled: false
      Topic: /lidar_candidate/unified/structure_evidence
      Color Transformer: FlatColor
      Color: 40; 200; 255
      Style: Flat Squares
      Size (m): 0.08
      Alpha: 0.9
      Queue Size: 1
      Decay Time: 0
    - Class: rviz/MarkerArray
      Name: Frame-local unclassified OBB and unconfirmed structure
      Enabled: false
      Marker Topic: /lidar_candidate/unified/markers
      Queue Size: 1
    - Class: rviz/MarkerArray
      Name: Tracks observed green predicted orange ID speed
      Enabled: true
      Marker Topic: /lidar_candidate/unified/tracks
      Queue Size: 1
    - Class: rviz/MarkerArray
      Name: Jaeho ground plane attempts
      Enabled: false
      Marker Topic: /lidar_candidate/ground_live/fit_markers
      Queue Size: 1
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 45
      Focal Point:
        X: 12
        Y: 0
        Z: 0
      Pitch: 0.85
      Yaw: 0
