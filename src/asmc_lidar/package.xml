<?xml version="1.0"?>
<package format="2">
  <name>asmc_lidar</name>
  <version>0.1.0</version>
  <description>Isolated LiDAR reference and ground review runtime.</description>
  <maintainer email="autonav@todo.todo">Autonav</maintainer>
  <license>MIT</license>
  <!-- Vendored Patchwork++ / linefit retain their upstream licenses. -->
  <license>BSD-2-Clause</license>
  <license>BSD-3-Clause</license>
  <buildtool_depend>catkin</buildtool_depend>
  <depend>roscpp</depend>
  <depend>asmc_msgs</depend>
  <depend>asmc_bridge</depend>
  <depend>morai_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>pcl_ros</depend>
  <depend>pcl_conversions</depend>
  <build_depend>libeigen3-dev</build_depend>
  <build_depend>libpcl-dev</build_depend>
  <depend>libssl-dev</depend>
  <exec_depend>rviz</exec_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <export/>
</package>
