<?xml version="1.0"?>
<package format="2">
  <name>asmc_lidar</name>
  <version>0.1.0</version>
  <description>Canonical LiDAR perception: coordinate/time core, camera observation receiver, detection/tracking/front fusion, delivery filtering, ROS runtime and offline replay.</description>
  <maintainer email="autonav@todo.todo">Autonav</maintainer>
  <license>MIT</license>
  <buildtool_depend>catkin</buildtool_depend>
  <depend>asmc_msgs</depend>
  <depend>eigen</depend>
  <depend>roscpp</depend>
  <depend>diagnostic_msgs</depend>
  <depend>yaml-cpp</depend>
  <depend>openssl</depend>
  <!-- Migration pipeline (package-private, not exported to dependents such as Main).
       build/exec only: no build_export_depend, so catkin_package exports stay unchanged. -->
  <build_depend>libopencv-dev</build_depend>
  <build_depend>zlib</build_depend>
  <exec_depend>zlib</exec_depend>
  <exec_depend>libopencv-dev</exec_depend>
  <build_depend>libpcl-all-dev</build_depend>
  <exec_depend>libpcl-all</exec_depend>
  <build_depend>geographiclib</build_depend>
  <exec_depend>geographiclib</exec_depend>
  <build_depend>pcl_conversions</build_depend>
  <exec_depend>pcl_conversions</exec_depend>
  <build_depend>sensor_msgs</build_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <build_depend>std_msgs</build_depend>
  <exec_depend>std_msgs</exec_depend>
  <build_depend>geometry_msgs</build_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <build_depend>morai_msgs</build_depend>
  <exec_depend>morai_msgs</exec_depend>
  <build_depend>rosbag</build_depend>
  <exec_depend>rosbag</exec_depend>
  <build_depend>std_srvs</build_depend>
  <exec_depend>std_srvs</exec_depend>
  <build_depend>tf2_ros</build_depend>
  <exec_depend>tf2_ros</exec_depend>
  <!-- Optional read-only RViz adapter; no inference or Main dependency. -->
  <exec_depend>rospy</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>rviz</exec_depend>
  <!-- Read-only web monitor dependencies. -->
  <exec_depend>rosgraph</exec_depend>
  <exec_depend>python3-rospkg</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <test_depend>python3-opencv</test_depend>
  <test_depend>rostest</test_depend>
  <test_depend>rospy</test_depend>
  <test_depend>python3-yaml</test_depend>
  <test_depend>python3-numpy</test_depend>
  <export/>
</package>
