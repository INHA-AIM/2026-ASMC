<launch>
  <arg name="method" default="all"/>
  <arg name="patchwork_variant" default="guard25"/>
  <arg name="rviz" default="true"/>
  <arg name="start_bridge" default="false"/>
  <arg name="transport_profile" default="local"/>
  <arg name="stream_profile" default="competition"/>
  <arg name="timestamp_mode" default="receive"/>
  <arg name="cmd_ip" default="$(eval '192.168.0.1' if arg('transport_profile') == 'lan2lan' else '127.0.0.1')"/>
  <arg name="cloud_topic" default="/velodyne_points"/>
  <arg name="imu_topic" default="/imu"/>
  <!-- Use start_bridge=false with an already running bridge. -->
  <include if="$(arg start_bridge)" file="$(find asmc_bridge)/launch/bridge.launch">
    <arg name="transport_profile" value="$(arg transport_profile)"/>
    <arg name="stream_profile" value="$(arg stream_profile)"/>
    <arg name="timestamp_mode" value="$(arg timestamp_mode)"/>
    <arg name="cmd_ip" value="$(arg cmd_ip)"/>
  </include>
  <node pkg="asmc_lidar" type="asmc_lidar_ground_live_node" name="ground_compare_live" required="true" output="screen">
    <param name="method" value="$(arg method)"/>
    <param name="patchwork_variant" value="$(arg patchwork_variant)"/>
    <param name="cloud_topic" value="$(arg cloud_topic)"/>
    <param name="imu_topic" value="$(arg imu_topic)"/>
    <param name="stamp_provenance" value="$(eval 'simulator_source' if arg('timestamp_mode') == 'source' else 'bridge_receive')"/>
    <param name="calibration_path" value="$(find asmc_lidar)/config/autonav_v3.yaml"/>
  </node>
  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="ground_compare_live_rviz"
        args="-d $(find asmc_lidar)/rviz/ground_compare_live.rviz"/>
</launch>
