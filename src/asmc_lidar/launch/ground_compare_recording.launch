<launch>
  <!-- Saved candidate outputs only. Never replay raw sensors, Ego, commands, TF or /clock
       onto the live bridge. Stop ground_compare_live before using this view. -->
  <arg name="bag"/>
  <arg name="rviz" default="true"/>
  <arg name="rate" default="1.0"/>
  <arg name="start" default="0.0"/>
  <node pkg="rosbag" type="play" name="ground_compare_recording" required="true"
        args="&quot;$(arg bag)&quot; --loop --rate $(arg rate) --start $(arg start) --topics /lidar_candidate/ground_live/status /lidar_candidate/ground_live/fit_markers /lidar_candidate/ground_live/jaeho/ground /lidar_candidate/ground_live/jaeho/nonground /lidar_candidate/ground_live/jaeho/uncertain /lidar_candidate/ground_live/jaeho/structural_removed /lidar_candidate/ground_live/patchwork/ground /lidar_candidate/ground_live/patchwork/nonground /lidar_candidate/ground_live/patchwork/uncertain /lidar_candidate/ground_live/patchwork/structural_removed /lidar_candidate/ground_live/linefit/ground /lidar_candidate/ground_live/linefit/nonground /lidar_candidate/ground_live/linefit/uncertain /lidar_candidate/ground_live/linefit/structural_removed /lidar_candidate/ground_live/jaeho/native_retained"/>
  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="ground_compare_recording_rviz"
        args="-d $(find asmc_lidar)/rviz/ground_compare_live.rviz"/>
</launch>
