<launch>
  <!-- asmc_lidar shadow pipeline + read-only web monitor.
       Starts (a) asmc_lidar_shadow_node with its monitoring-only stage output
       (~debug_enabled, rate-limited clouds under debug_topic_prefix) unless
       start_pipeline:=false, and (b) asmc_lidar_monitor_node.py, an HTTP server
       on bind_address:dashboard_port (loopback by default) that only reads
       /asmc_lidar/shadow/* topics. No LiDAR driver, MORAI bridge, camera,
       inference, Main or planner node is started; the operational outputs of
       the shadow node stay refused (see shadow_pipeline.launch). Running this
       next to Main processes the LiDAR twice (two independent pipelines).
       open_browser:=true opens the page once after the server's health check.
       Not included by any other launch file. -->
  <arg name="start_pipeline" default="true" doc="false: observe an already running shadow node (debug_enabled:=true)"/>
  <arg name="open_browser" default="false" doc="open the page once after the HTTP server is ready"/>
  <arg name="dashboard_port" default="8091" doc="HTTP port (the planner dashboard uses 8088)"/>
  <arg name="bind_address" default="127.0.0.1" doc="HTTP bind address; 0.0.0.0 exposes the page to other hosts"/>
  <arg name="max_clients" default="8" doc="HTTP connections handled at once (checked before parsing); more get 503 or are closed"/>
  <arg name="http_header_timeout_s" default="5.0" doc="a connection must send its complete request headers within this"/>
  <arg name="http_request_timeout_s" default="20.0" doc="a connection is closed this long after accept (response included)"/>
  <arg name="debug_rate_hz" default="5.0" doc="stage snapshots per second published by the shadow node"/>
  <arg name="debug_max_points" default="20000" doc="points per stage cloud sent; larger clouds are stride-sampled"/>
  <arg name="debug_topic_prefix" default="/asmc_lidar/shadow/debug"/>

  <arg name="pipeline_config" default="$(find asmc_lidar)/config/shadow_pipeline.yaml"/>
  <!-- Empty = keep config/shadow_pipeline.yaml (lidar.level_roll: true, experimental
       tunnel_filter.enabled: false); a value overrides the file. -->
  <arg name="lidar_level_roll" default=""/>
  <!-- Empty = fusion.enable_sensor_fusion of the YAML (true); false = no camera subscription. -->
  <arg name="enable_camera_fusion" default=""/>
  <!-- Empty = the node looks for asmc_camera/config/cameras_v3.yaml on ROS_PACKAGE_PATH and runs
       LiDAR-only (warning) when the camera package is absent; no hard $(find asmc_camera). -->
  <arg name="camera_calibration_config" default=""/>
  <arg name="experimental_tunnel_filter" default=""/>
  <arg name="publish_tf" default="false"/>
  <arg name="tf_child_frame" default="asmc_lidar_shadow/lidar_leveled"/>

  <arg name="points_topic" default="/velodyne_points"/>
  <arg name="imu_topic" default="/imu"/>
  <arg name="can_topic" default="/Ego_topic"/>
  <arg name="gps_topic" default="/gps"/>
  <arg name="camera_observations_topic" default="/perception/camera/objects/observations"/>
  <arg name="camera_status_topic" default="/perception/camera/objects/status"/>

  <arg name="objects_local_topic" default="/asmc_lidar/shadow/objects_local"/>
  <arg name="objects_map_topic" default="/asmc_lidar/shadow/objects_map"/>
  <arg name="diagnostics_topic" default="/asmc_lidar/shadow/diagnostics"/>
  <arg name="trace_topic" default="/asmc_lidar/shadow/trace"/>

  <node if="$(arg start_pipeline)" pkg="asmc_lidar" type="asmc_lidar_shadow_node" name="asmc_lidar_shadow" output="screen">
    <param name="pipeline_config" value="$(arg pipeline_config)"/>
    <param name="package_dir" value="$(find asmc_lidar)"/>
    <param if="$(eval arg('lidar_level_roll') != '')" name="lidar_level_roll" value="$(arg lidar_level_roll)"/>
    <param if="$(eval arg('enable_camera_fusion') != '')" name="enable_camera_fusion"
           value="$(arg enable_camera_fusion)"/>
    <param if="$(eval arg('camera_calibration_config') != '')" name="camera_calibration_config"
           value="$(arg camera_calibration_config)"/>
    <param if="$(eval arg('experimental_tunnel_filter') != '')" name="experimental_tunnel_filter"
           value="$(arg experimental_tunnel_filter)"/>
    <param name="publish_tf" value="$(arg publish_tf)"/>
    <param name="tf_child_frame" value="$(arg tf_child_frame)"/>
    <param name="points_topic" value="$(arg points_topic)"/>
    <param name="imu_topic" value="$(arg imu_topic)"/>
    <param name="can_topic" value="$(arg can_topic)"/>
    <param name="gps_topic" value="$(arg gps_topic)"/>
    <param name="camera_observations_topic" value="$(arg camera_observations_topic)"/>
    <param name="camera_status_topic" value="$(arg camera_status_topic)"/>
    <param name="objects_local_topic" value="$(arg objects_local_topic)"/>
    <param name="objects_map_topic" value="$(arg objects_map_topic)"/>
    <param name="diagnostics_topic" value="$(arg diagnostics_topic)"/>
    <param name="trace_topic" value="$(arg trace_topic)"/>
    <!-- Monitoring-only stage output (default OFF in shadow_pipeline.launch). -->
    <param name="debug_enabled" value="true"/>
    <param name="debug_topic_prefix" value="$(arg debug_topic_prefix)"/>
    <param name="debug_rate_hz" value="$(arg debug_rate_hz)"/>
    <param name="debug_max_points" value="$(arg debug_max_points)"/>
  </node>

  <!-- required=false: a bind failure (port in use) stops only the monitor; the LiDAR node keeps running. -->
  <node pkg="asmc_lidar" type="asmc_lidar_monitor_node.py" name="asmc_lidar_monitor" output="screen" required="false">
    <param name="pipeline_config" value="$(arg pipeline_config)"/>
    <param name="port" value="$(arg dashboard_port)"/>
    <param name="bind_address" value="$(arg bind_address)"/>
    <param name="open_browser" value="$(arg open_browser)"/>
    <param name="max_clients" value="$(arg max_clients)"/>
    <param name="header_timeout_s" value="$(arg http_header_timeout_s)"/>
    <param name="request_timeout_s" value="$(arg http_request_timeout_s)"/>
    <param name="web_dir" value="$(find asmc_lidar)/web"/>
    <param name="debug_topic_prefix" value="$(arg debug_topic_prefix)"/>
    <param name="diagnostics_topic" value="$(arg diagnostics_topic)"/>
    <param name="objects_local_topic" value="$(arg objects_local_topic)"/>
    <param name="objects_map_topic" value="$(arg objects_map_topic)"/>
    <param name="points_topic" value="$(arg points_topic)"/>
  </node>
</launch>
