<launch>
  <!-- Canonical asmc_lidar entry point: port of Main's common-geometry path.
       Starts one lidar_pipeline_node, optionally RViz + a read-only marker adapter.
       No LiDAR driver, MORAI bridge, camera,
       inference or planner node, and no operational output: outputs default to
       /migration/lidar/* and the node refuses operational names
       (/last_lidar, /lidar_nogps, /YOLO/BBox, /perception/lidar/*, /planning/*,
       /tf, /tf_static, its own input topics; TF child lidar_leveled/base_link/map/velodyne).
       No visualization server or browser is started here. The read-only
       localhost viewer runs separately in view.launch.
       Previous entry points: lidar_pipeline.launch and lidar_only.launch.
       LiDAR-only, including without asmc_camera installed: fusion:=false. -->
  <arg name="namespace" default="/migration/lidar" doc="Output namespace; inputs keep their canonical paths"/>
  <arg name="pipeline_config" default="$(find asmc_lidar)/config/lidar_pipeline.yaml" doc="Processing configuration YAML"/>
  <!-- Empty = keep config/lidar_pipeline.yaml (lidar.level_roll: true, experimental
       tunnel_filter.enabled: false); a value overrides the file. -->
  <arg name="lidar_level_roll" default=""/>
  <!-- Public switch. The internal parameter/YAML names stay unchanged. -->
  <arg name="fusion" default="true" doc="Use camera observations for classification; false runs LiDAR alone"/>
  <arg name="rviz" default="false" doc="Open RViz and display this pipeline's published objects and ego box"/>
  <!-- Resolve the camera-owned file in SetUpCamera only when fusion is on.
       An eager camera-package lookup would break camera-free installations.
       Empty keeps the node's existing discovery policy. -->
  <arg name="camera_calibration_config" default=""/>
  <arg name="experimental_tunnel_filter" default=""/>
  <arg name="publish_tf" default="false"/>
  <arg name="tf_child_frame" default="lidar_pipeline/lidar_leveled"/>

  <!-- Monitoring only: subscribers and rate limit still gate each snapshot. -->
  <arg name="debug" default="false" doc="Publish sampled stages for view.launch; no algorithm changes"/>
  <arg name="debug_rate_hz" default="5.0"/>
  <arg name="debug_max_points" default="20000"/>

  <arg name="points_topic" default="/velodyne_points"/>
  <arg name="imu_topic" default="/imu"/>
  <arg name="can_topic" default="/Ego_topic"/>
  <arg name="gps_topic" default="/gps"/>
  <arg name="camera_observations_topic" default="/perception/camera/objects/observations"/>
  <arg name="camera_status_topic" default="/perception/camera/objects/status"/>

  <arg name="objects_local_topic" default="objects_local"/>
  <arg name="objects_map_topic" default="objects_map"/>
  <arg name="observations_local_topic" default="observations_local"/>
  <arg name="observations_map_topic" default="observations_map"/>
  <arg name="diagnostics_topic" default="diagnostics"/>
  <arg name="trace_topic" default="trace"/>

  <node pkg="asmc_lidar" type="lidar_pipeline_node" name="lidar_pipeline" ns="$(arg namespace)" output="screen">
    <param name="debug_enabled" value="$(arg debug)"/>
    <param name="debug_topic_prefix" value="debug"/>
    <param name="debug_rate_hz" value="$(arg debug_rate_hz)"/>
    <param name="debug_max_points" value="$(arg debug_max_points)"/>
    <param name="pipeline_config" value="$(arg pipeline_config)"/>
    <param name="package_dir" value="$(find asmc_lidar)"/>
    <param if="$(eval arg('lidar_level_roll') != '')" name="lidar_level_roll" value="$(arg lidar_level_roll)"/>
    <param name="enable_camera_fusion" value="$(arg fusion)"/>
    <param name="camera_calibration_config" value="$(arg camera_calibration_config)"/>
    <param if="$(eval arg('experimental_tunnel_filter') != '')" name="experimental_tunnel_filter"
           value="$(arg experimental_tunnel_filter)"/>
    <param name="publish_tf" value="$(arg publish_tf)"/>
    <param name="tf_child_frame" value="$(arg tf_child_frame)"/>
    <param name="points_topic" value="$(arg points_topic)"/>
    <param name="imu_topic" value="$(arg imu_topic)"/>
    <param name="can_topic" value="$(arg can_topic)"/>
    <param name="gps_topic" value="$(arg gps_topic)"/>
    <param name="camera_observations_topic" value="$(arg camera_observations_topic)"/>
    <param name="camera_status_topic" value="$(arg camera_status_topic)"/>
    <param name="objects_local_topic" value="$(arg objects_local_topic)"/>
    <param name="objects_map_topic" value="$(arg objects_map_topic)"/>
    <param name="observations_local_topic" value="$(arg observations_local_topic)"/>
    <param name="observations_map_topic" value="$(arg observations_map_topic)"/>
    <param name="diagnostics_topic" value="$(arg diagnostics_topic)"/>
    <param name="trace_topic" value="$(arg trace_topic)"/>
  </node>

  <!-- Explicit GUI request only. Never starts another perception pipeline.
       Keep rviz:=false when attaching an already open RViz manually. -->
  <group if="$(arg rviz)">
    <node pkg="asmc_lidar" type="lidar_markers.py" name="lidar_markers" ns="$(arg namespace)" output="screen">
      <param name="input" value="$(arg observations_local_topic)"/>
      <param name="output" value="markers"/>
    </node>
    <node pkg="rviz" type="rviz" name="lidar_rviz" ns="$(arg namespace)"
          args="-d $(find asmc_lidar)/rviz/lidar.rviz" required="false">
      <!-- The standalone preset keeps the default namespace; remap for this launch. -->
      <remap from="/migration/lidar/markers" to="markers"/>
      <remap from="/velodyne_points" to="$(arg points_topic)"/>
    </node>
  </group>
</launch>
