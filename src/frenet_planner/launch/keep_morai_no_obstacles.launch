<launch>
  <!-- Obstacle-free KEEP E2E. LiDAR/perception code is not used. -->
  <arg name="state_source" default="gps_imu" doc="gps_imu or ego_dev"/>
  <arg name="dashboard" default="false"/>
  <arg name="start_morai_bridges" default="true"/>

  <group if="$(arg start_morai_bridges)">
    <include file="$(find morai_sensor_bridge)/launch/morai_sensor_bridge.launch">
      <arg name="enable_lidar" value="false"/>
      <arg name="enable_semantic_camera" value="false"/>
    </include>
    <include file="$(find morai_udp_bridge)/launch/morai_udp_bridge.launch"/>
  </group>

  <include if="$(eval arg('state_source') == 'gps_imu')"
           file="$(find frenet_planner)/launch/vehicle_state_gps_imu.launch"/>
  <include if="$(eval arg('state_source') == 'ego_dev')"
           file="$(find frenet_planner)/launch/vehicle_state_ego_dev.launch"/>
  <node pkg="frenet_planner" type="empty_objects_test_publisher"
        name="empty_objects_test_publisher" output="screen"/>
  <include file="$(find behavior_planner)/launch/behavior_node.launch">
    <arg name="dashboard" value="$(arg dashboard)"/>
  </include>
  <include file="$(find frenet_planner)/launch/frenet_planner.launch"/>
  <include file="$(find mpc_controller)/launch/mpc_ros.launch"/>
</launch>
