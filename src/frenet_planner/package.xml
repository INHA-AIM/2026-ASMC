<?xml version="1.0"?>
<package format="2">
  <name>frenet_planner</name>
  <version>0.1.0</version>
  <description>Frenet trajectory planner core with a ROS runtime.</description>

  <maintainer email="autonav@todo.todo">autonav</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>asmc_msgs</depend>
  <depend>morai_msgs</depend>
  <depend>roscpp</depend>
  <depend>sensor_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>yaml-cpp</depend>

  <!-- Launch-only dependencies for obstacle-free MORAI KEEP verification. -->
  <exec_depend>asmc_bridge</exec_depend>
  <exec_depend>behavior_planner</exec_depend>
  <exec_depend>mpc_controller</exec_depend>

  <export/>
</package>
