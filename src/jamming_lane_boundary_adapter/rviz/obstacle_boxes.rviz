Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: base_link
    Background Color: 24; 24; 24
    Frame Rate: 20
  Displays:
    - Class: rviz/Grid
      Name: Metric Grid
      Enabled: true
      Value: true
      Cell Size: 1
      Plane Cell Count: 60
      Plane: XY
      Alpha: 0.25
      Color: 160; 160; 160
      Reference Frame: <Fixed Frame>
      Offset:
        X: 0
        Y: 0
        Z: -0.36
    - Class: rviz/Axes
      Name: Vehicle Origin
      Enabled: true
      Value: true
      Reference Frame: base_link
      Length: 1
      Radius: 0.04
    - Class: rviz/MarkerArray
      Name: Camera Detected Lanes
      Enabled: true
      Value: true
      Marker Topic: /perception/lane/debug/markers
      Queue Size: 1
    # 재밍 판단 장애물(road_obstacle), 선 좌표로 기억한 장애물(line_obstacle),
    # 회피 대상(avoid_obstacle), 선택 경로와 추종점.
    - Class: rviz/MarkerArray
      Name: Jamming Obstacles and Target Line
      Enabled: true
      Value: true
      Marker Topic: /planning/camera_bbox_lane_change/markers
      Queue Size: 1
    # LiDAR OBB/ID/분류. D를 rviz:=true(기본)로 띄우면 lidar_markers가 발행한다.
    # 재밍 중에는 LiDAR가 멈추므로 마지막 박스에서 갱신되지 않는다.
    - Class: rviz/MarkerArray
      Name: LiDAR Objects
      Enabled: true
      Value: true
      Marker Topic: /perception/lidar/markers
      Queue Size: 1
    - Class: rviz/PointCloud2
      Name: Raw LiDAR
      Enabled: false
      Value: false
      Topic: /velodyne_points
      Queue Size: 1
      Style: Points
      Size (Pixels): 2
      Alpha: 0.4
      Color Transformer: Intensity
      Decay Time: 0
    # 카메라 BBOX와 차로 판정(OWN/ADJACENT/BOTH/UNKNOWN) 오버레이.
    - Class: rviz/Image
      Name: Camera BBOX Lane Classification
      Enabled: true
      Value: true
      Image Topic: /planning/camera_bbox_lane/image
      Transport Hint: raw
      Queue Size: 1
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
  Views:
    Current:
      Class: rviz/TopDownOrtho
      Name: Current View
      Target Frame: base_link
      Angle: -1.5707963267948966
      Scale: 25
      X: 12
      Y: 0
  Enabled: true
  Name: root
Window Geometry:
  Width: 1400
  Height: 900
  X: 50
  Y: 50
