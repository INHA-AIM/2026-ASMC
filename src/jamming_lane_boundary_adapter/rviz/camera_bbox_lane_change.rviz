Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: base_link
    Background Color: 24; 24; 24
    Frame Rate: 20
  Displays:
    - Class: rviz/Grid
      Name: Metric Grid
      Enabled: true
      Value: true
      Cell Size: 1
      Plane Cell Count: 40
      Plane: XY
      Alpha: 0.25
      Color: 160; 160; 160
      Reference Frame: <Fixed Frame>
      Offset:
        X: 0
        Y: 0
        Z: -0.36
    - Class: rviz/Axes
      Name: Vehicle Origin
      Enabled: true
      Value: true
      Reference Frame: base_link
      Length: 1
      Radius: 0.04
    - Class: rviz/MarkerArray
      Name: Camera Detected Lanes
      Enabled: true
      Value: true
      Marker Topic: /perception/lane/debug/markers
      Queue Size: 1
    - Class: rviz/MarkerArray
      Name: Lane Centers and Following Target
      Enabled: true
      Value: true
      Marker Topic: /planning/camera_bbox_lane_change/markers
      Queue Size: 1
    - Class: rviz/Image
      Name: BBOX Lane Classification
      Enabled: true
      Value: true
      Image Topic: /planning/camera_bbox_lane/image
      Transport Hint: raw
      Queue Size: 1
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
  Views:
    Current:
      Class: rviz/TopDownOrtho
      Name: Current View
      Target Frame: base_link
      Angle: -1.5707963267948966
      Scale: 35
      X: 6
      Y: 0
  Enabled: true
  Name: root
Window Geometry:
  Width: 1100
  Height: 850
  X: 50
  Y: 50
