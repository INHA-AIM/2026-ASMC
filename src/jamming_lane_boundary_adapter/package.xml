<?xml version="1.0"?>
<package format="2">
  <name>lane_boundary_adapter</name>
  <version>0.1.0</version>
  <description>
    C++ lane-boundary adapters, read-only monitors, and opt-in camera/BBOX lane following and lane changes.
  </description>

  <maintainer email="autonav@todo.todo">ASMC</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>message_generation</build_depend>
  <exec_depend>message_runtime</exec_depend>
  <depend>opencv2</depend>
  <depend>yaml-cpp</depend>
  <depend>libssl-dev</depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>asmc_camera</exec_depend>
  <depend>asmc_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>morai_msgs</depend>
  <depend>roscpp</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>sensor_msgs</depend>

  <exec_depend>rviz</exec_depend>

  <test_depend>rostest</test_depend>
  <test_depend>python3-yaml</test_depend>
  <test_depend>rospy</test_depend>

  <export/>
</package>
