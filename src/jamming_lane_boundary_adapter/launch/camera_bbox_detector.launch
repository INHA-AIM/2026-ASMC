<launch>
  <!-- CPU conversion only. Start asmc_camera/camera.launch separately. -->
  <arg name="bbox_topic" default="/planning/camera_bbox_lane/yolo"/>
  <!-- Existing jamming consumer cutoff, intentionally independent of producer0.40. -->
  <arg name="conf_thres" default="0.7"/>
  <node pkg="Main"
        type="camera_objects_yolo_bbox_adapter.py" name="jamming_camera_objects_adapter" output="screen">
    <remap from="/YOLO/BBox" to="$(arg bbox_topic)"/>
    <param name="conf_thres" value="$(arg conf_thres)"/>
  </node>
</launch>
