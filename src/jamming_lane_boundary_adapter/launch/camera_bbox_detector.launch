<launch>
  <!-- asmc-perception-train에서 실행. 기존 detector 코드/weight를 읽기 전용 재사용. -->
  <arg name="image_topic" default="/image_jpeg/compressed"/>
  <arg name="hood_crop_bottom_ratio" default="0.21"/>
  <arg name="detector_image_topic" default="/planning/camera_bbox_lane/detector_input/compressed"/>
  <arg name="bbox_topic" default="/planning/camera_bbox_lane/yolo"/>
  <arg name="weights" default="$(find Main)/YOLOWeight/yolo11m.pt"/>
  <arg name="device" default="cuda:0"/>
  <arg name="conf_thres" default="0.7"/>
  <arg name="python" default="/opt/asmc-py39/bin/python3"/>
  <arg name="dependencies" default="/opt/camera-bbox-deps"/>
  <node pkg="lane_boundary_adapter" type="camera_bbox_crop.py" name="camera_bbox_crop" output="screen" required="true">
    <param name="input_topic" value="$(arg image_topic)"/>
    <param name="output_topic" value="$(arg detector_image_topic)"/>
    <param name="hood_crop_bottom_ratio" value="$(arg hood_crop_bottom_ratio)"/>
  </node>
  <node pkg="Main" type="yolo_detection_node" name="camera_bbox_detector" output="screen" required="true">
    <env name="ASMC_YOLO_PYTHON" value="$(arg python)"/>
    <env name="PYTHONPATH" value="$(arg dependencies):$(optenv PYTHONPATH)"/>
    <param name="weights" value="$(arg weights)"/>
    <param name="device" value="$(arg device)"/>
    <param name="require_cuda" value="true"/>
    <param name="conf_thres" value="$(arg conf_thres)"/>
    <remap from="/camera/image/compressed" to="$(arg detector_image_topic)"/>
    <remap from="/YOLO/BBox" to="$(arg bbox_topic)"/>
  </node>
</launch>
