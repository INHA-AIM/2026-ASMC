<launch>
  <arg name="clipped_tracking_speed_kph" default="5.0"/>
  <arg name="contact_band_height_px" default="8.0"/>
  <arg name="contact_row_tolerance_px" default="8.0"/>
  <arg name="min_contact_overlap_ratio" default="0.10"/>
  <arg name="min_contact_support_rows" default="3"/>
  <!-- BBOX 판정 + 장애물에 따른 반복 차선변경. GPU detector와 카메라 차선 인식은 별도 실행. -->
  <arg name="hood_crop_bottom_ratio" default="0.0"/>
  <arg name="ego_mask_enabled" default="$(eval float(arg('hood_crop_bottom_ratio')) == 0)"/>
  <arg name="ego_mask_config" default="$(find asmc_camera)/config/camera/yolo_hood_mask_v1.yaml"/>
  <arg name="enable_control" default="false"/>
  <arg name="lookahead_distance" default="8.0"/>
  <arg name="target_speed_kph" default="20.0"/>
  <arg name="inferred_speed_kph" default="20.0"/>
  <arg name="wheelbase" default="3.0"/>
  <arg name="steering_curvature_gain" default="0.844"/>
  <arg name="max_steering_deg" default="40.0"/>
  <arg name="max_steering_rate" default="1.0"/>
  <arg name="max_lateral_accel" default="1.0"/>
  <arg name="control_rate" default="20.0"/>
  <arg name="source_timeout" default="0.5"/>
  <arg name="receive_timeout" default="0.35"/>
  <arg name="future_tolerance" default="0.05"/>
  <arg name="lane_index" default="-1"/>
  <arg name="lane_confirm_frames" default="3"/>
  <arg name="lane_selection_distance" default="4.0"/>
  <arg name="lane_boundary_margin" default="0.15"/>
  <arg name="allow_inferred" default="true"/>
  <arg name="min_confidence" default="0.25"/>
  <arg name="join_tolerance" default="1e-4"/>
  <arg name="stop_brake" default="1.0"/>
  <arg name="shutdown_stop_duration" default="0.3"/>
  <arg name="marker_z" default="-0.30"/>
  <arg name="epsilon" default="1e-6"/>
  <arg name="max_steering_dt" default="0.1"/>
  <arg name="consumer_x_min" default="0.0"/>
  <arg name="consumer_x_max" default="15.0"/>
  <arg name="min_segment_length" default="0.25"/>
  <arg name="lane_width_min" default="2.4"/>
  <arg name="lane_width_max" default="4.6"/>
  <arg name="max_width_variation" default="0.8"/>
  <arg name="inferred_confidence_scale" default="0.60"/>
  <!-- Classifier and follower pin the same current M1 config. The classifier also
       validates exact image-time plane metadata; this is not closed-loop approval.
       Standalone control remains opt-in. See camera-to-planning.md 7.1. -->
  <arg name="expected_config_sha256" default="2d17cf63adbf2ba049d70656233ee2f34e9a4bfb43373ee76b3371aab1e4dc2a"/>
  <arg name="input_topic" default="/perception/lane/boundary_family"/>
  <arg name="control_topic" default="/ctrl_cmd/jamming"/>
  <arg name="preview_topic" default="/planning/camera_bbox_lane_change/control_preview"/>
  <arg name="target_topic" default="/planning/camera_bbox_lane_change/target"/>
  <arg name="markers_topic" default="/planning/camera_bbox_lane_change/markers"/>
  <arg name="diagnostics_topic" default="/planning/camera_bbox_lane_change/diagnostics"/>
  <arg name="emergency_stop_topic" default="/planning/camera_bbox_lane_change/emergency_stop"/>
  <arg name="bbox_topic" default="/planning/camera_bbox_lane/result"/>
  <arg name="reference_lane_topic" default="/planning/camera_bbox_lane_change/reference_lane"/>
  <arg name="far_obstacle_speed_kph" default="5.0"/>
  <arg name="bbox_source_timeout" default="0.5"/>
  <arg name="bbox_receive_timeout" default="0.5"/>
  <arg name="max_sensor_skew" default="0.4"/>
  <arg name="obstacle_confirm_frames" default="2"/>
  <arg name="adjacent_clear_frames" default="3"/>
  <arg name="ignore_bbox_during_lane_change" default="true"/>
  <arg name="one_lane_change_only" default="false"/>
  <arg name="obstacle_lateral_margin" default="0.30"/>
  <arg name="obstacle_longitudinal_margin" default="0.5"/>
  <arg name="vehicle_front" default="3.845"/>
  <arg name="vehicle_rear" default="0.790"/>
  <arg name="vehicle_width" default="1.892"/>
  <arg name="planning_start_x" default="1.0"/>
  <arg name="path_horizon" default="11.0"/>
  <arg name="path_sample_step" default="0.25"/>
  <arg name="max_lateral_step" default="2.4"/>
  <arg name="lane_change_length" default="10.0"/>
  <arg name="lane_change_speed_kph" default="15.0"/>
  <arg name="completion_lateral_error" default="0.30"/>
  <arg name="completion_heading_deg" default="8.0"/>
  <arg name="completion_confirm_frames" default="3"/>
  <arg name="lane_change_pause_timeout" default="30.0"/>
  <arg name="lane_change_timeout" default="15.0"/>
  <arg name="lane_change_cooldown" default="4.0"/>
  <arg name="use_rviz" default="true"/>
  <arg name="bbox_consumer_x_max" default="20.0"/>
  <arg name="start_classifier" default="true"/>
  <arg name="projection_context_required" default="true"/>
  <arg name="projection_manifest" default="$(find asmc_camera)/config/bev/projection_context_v1.yaml"/>
  <arg name="calibration_file" default="$(find asmc_camera)/config/cameras_v3.yaml"/>
  <include if="$(arg start_classifier)" file="$(find lane_boundary_adapter)/launch/camera_bbox_lane.launch">
    <arg name="use_rviz" value="false"/>
    <arg name="contact_band_height_px" value="$(arg contact_band_height_px)"/>
    <arg name="contact_row_tolerance_px" value="$(arg contact_row_tolerance_px)"/>
    <arg name="min_contact_overlap_ratio" value="$(arg min_contact_overlap_ratio)"/>
    <arg name="min_contact_support_rows" value="$(arg min_contact_support_rows)"/>

    <arg name="ego_mask_enabled" value="$(arg ego_mask_enabled)"/>
    <arg name="ego_mask_config" value="$(arg ego_mask_config)"/>
    <arg name="hood_crop_bottom_ratio" value="$(arg hood_crop_bottom_ratio)"/>
    <!-- Both consumers must validate the same explicitly selected producer config. -->
    <arg name="expected_hash" value="$(arg expected_config_sha256)"/>
    <arg name="projection_context_required" value="$(arg projection_context_required)"/>
    <arg name="projection_manifest" value="$(arg projection_manifest)"/>
    <arg name="calibration_file" value="$(arg calibration_file)"/>
    <arg name="consumer_x_max" value="$(arg bbox_consumer_x_max)"/>
    <arg name="source_timeout" value="$(arg source_timeout)"/>
    <arg name="max_sensor_skew" value="$(arg max_sensor_skew)"/>
    <arg name="reference_lane_topic" value="$(arg reference_lane_topic)"/>
  </include>
  <node pkg="lane_boundary_adapter" type="camera_bbox_lane_change_node" name="camera_bbox_lane_change" output="screen" required="true">
    <param name="clipped_tracking_speed_kph" value="$(arg clipped_tracking_speed_kph)"/>
    <param name="enable_control" type="bool" value="$(arg enable_control)"/>
    <param name="lookahead_distance" type="double" value="$(arg lookahead_distance)"/>
    <param name="target_speed_kph" type="double" value="$(arg target_speed_kph)"/>
    <param name="inferred_speed_kph" type="double" value="$(arg inferred_speed_kph)"/>
    <param name="wheelbase" type="double" value="$(arg wheelbase)"/>
    <param name="steering_curvature_gain" type="double" value="$(arg steering_curvature_gain)"/>
    <param name="max_steering_deg" type="double" value="$(arg max_steering_deg)"/>
    <param name="max_steering_rate" type="double" value="$(arg max_steering_rate)"/>
    <param name="max_lateral_accel" type="double" value="$(arg max_lateral_accel)"/>
    <param name="control_rate" type="double" value="$(arg control_rate)"/>
    <param name="source_timeout" type="double" value="$(arg source_timeout)"/>
    <param name="receive_timeout" type="double" value="$(arg receive_timeout)"/>
    <param name="future_tolerance" type="double" value="$(arg future_tolerance)"/>
    <param name="lane_index" type="int" value="$(arg lane_index)"/>
    <param name="lane_confirm_frames" type="int" value="$(arg lane_confirm_frames)"/>
    <param name="lane_selection_distance" type="double" value="$(arg lane_selection_distance)"/>
    <param name="lane_boundary_margin" type="double" value="$(arg lane_boundary_margin)"/>
    <param name="allow_inferred" type="bool" value="$(arg allow_inferred)"/>
    <param name="min_confidence" type="double" value="$(arg min_confidence)"/>
    <param name="join_tolerance" type="double" value="$(arg join_tolerance)"/>
    <param name="stop_brake" type="double" value="$(arg stop_brake)"/>
    <param name="shutdown_stop_duration" type="double" value="$(arg shutdown_stop_duration)"/>
    <param name="marker_z" type="double" value="$(arg marker_z)"/>
    <param name="epsilon" type="double" value="$(arg epsilon)"/>
    <param name="max_steering_dt" type="double" value="$(arg max_steering_dt)"/>
    <param name="consumer_x_min" type="double" value="$(arg consumer_x_min)"/>
    <param name="consumer_x_max" type="double" value="$(arg consumer_x_max)"/>
    <param name="min_segment_length" type="double" value="$(arg min_segment_length)"/>
    <param name="lane_width_min" type="double" value="$(arg lane_width_min)"/>
    <param name="lane_width_max" type="double" value="$(arg lane_width_max)"/>
    <param name="max_width_variation" type="double" value="$(arg max_width_variation)"/>
    <param name="inferred_confidence_scale" type="double" value="$(arg inferred_confidence_scale)"/>
    <param name="expected_config_sha256" type="str" value="$(arg expected_config_sha256)"/>
    <param name="input_topic" type="str" value="$(arg input_topic)"/>
    <param name="control_topic" type="str" value="$(arg control_topic)"/>
    <param name="preview_topic" type="str" value="$(arg preview_topic)"/>
    <param name="target_topic" type="str" value="$(arg target_topic)"/>
    <param name="markers_topic" type="str" value="$(arg markers_topic)"/>
    <param name="diagnostics_topic" type="str" value="$(arg diagnostics_topic)"/>
    <param name="emergency_stop_topic" type="str" value="$(arg emergency_stop_topic)"/>
    <param name="bbox_topic" type="str" value="$(arg bbox_topic)"/>
    <param name="reference_lane_topic" type="str" value="$(arg reference_lane_topic)"/>
    <param name="far_obstacle_speed_kph" type="double" value="$(arg far_obstacle_speed_kph)"/>
    <param name="bbox_source_timeout" type="double" value="$(arg bbox_source_timeout)"/>
    <param name="bbox_receive_timeout" type="double" value="$(arg bbox_receive_timeout)"/>
    <param name="max_sensor_skew" type="double" value="$(arg max_sensor_skew)"/>
    <param name="obstacle_confirm_frames" type="int" value="$(arg obstacle_confirm_frames)"/>
    <param name="adjacent_clear_frames" type="int" value="$(arg adjacent_clear_frames)"/>
    <param name="ignore_bbox_during_lane_change" type="bool" value="$(arg ignore_bbox_during_lane_change)"/>
    <param name="one_lane_change_only" type="bool" value="$(arg one_lane_change_only)"/>
    <param name="obstacle_lateral_margin" type="double" value="$(arg obstacle_lateral_margin)"/>
    <param name="obstacle_longitudinal_margin" type="double" value="$(arg obstacle_longitudinal_margin)"/>
    <param name="vehicle_front" type="double" value="$(arg vehicle_front)"/>
    <param name="vehicle_rear" type="double" value="$(arg vehicle_rear)"/>
    <param name="vehicle_width" type="double" value="$(arg vehicle_width)"/>
    <param name="planning_start_x" type="double" value="$(arg planning_start_x)"/>
    <param name="path_horizon" type="double" value="$(arg path_horizon)"/>
    <param name="path_sample_step" type="double" value="$(arg path_sample_step)"/>
    <param name="max_lateral_step" type="double" value="$(arg max_lateral_step)"/>
    <param name="lane_change_length" type="double" value="$(arg lane_change_length)"/>
    <param name="lane_change_speed_kph" type="double" value="$(arg lane_change_speed_kph)"/>
    <param name="completion_lateral_error" type="double" value="$(arg completion_lateral_error)"/>
    <param name="completion_heading_deg" type="double" value="$(arg completion_heading_deg)"/>
    <param name="completion_confirm_frames" type="int" value="$(arg completion_confirm_frames)"/>
    <param name="lane_change_pause_timeout" type="double" value="$(arg lane_change_pause_timeout)"/>
    <param name="lane_change_timeout" type="double" value="$(arg lane_change_timeout)"/>
    <param name="lane_change_cooldown" type="double" value="$(arg lane_change_cooldown)"/>
  </node>
  <node if="$(arg use_rviz)" pkg="rviz" type="rviz" name="camera_bbox_lane_change_rviz"
        args="-d $(find lane_boundary_adapter)/rviz/camera_bbox_lane_change.rviz"/>
</launch>
