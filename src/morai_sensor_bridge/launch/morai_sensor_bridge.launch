<launch>
  <!-- Shared packet/runtime profile for supported MORAI simulator releases. -->
  <arg name="runtime_profile" default="morai_udp"/>
  <arg name="transport_profile" default="local"/>
  <arg name="stream_profile" default="competition"/>
  <!-- AIM06 Sensor Dest: cam1–4 / lidar / gps / imu (+ optional semantic) -->
  <!-- Dest 순서: cam1–4 → lidar → gps → imu. Host는 SIM bind — listen/publish 금지. -->
  <arg name="lidar_port"      default="9299"/>
  <arg name="lidar_topic"     default="/velodyne_points"/>
  <arg name="lidar_host_port" default="0"/>
  <!-- Privileged GT streams are explicit development-only inputs. -->
  <arg name="enable_instance_lidar" default="$(eval arg('stream_profile') == 'development')"/>
  <arg name="instance_lidar_port" default="9311"/>
  <arg name="instance_lidar_topic" default="/velodyne_points_instance"/>
  <arg name="timestamp_mode" default="receive"/>
  <arg name="gps_port"        default="9301"/>
  <arg name="imu_port"        default="9303"/>
  <!-- standalone Frenet planner 전용 raw UDP 복제 포트 -->
  <arg name="planner_forward_ip" default="127.0.0.1"/>
  <arg name="planner_gps_port"   default="9401"/>
  <arg name="planner_imu_port"   default="9403"/>
  <!-- KATRI map local origin: UTM52N - offset = planner/map coordinates. -->
  <arg name="gps_east_offset"  default="302595.0"/>
  <arg name="gps_north_offset" default="4124145.0"/>
  <!-- Raw GPS+latest-IMU map TF is an opt-in visualization/fusion aid. Keep
       false by default so it cannot compete with the localization stack's
       authoritative map -> base_link transform. -->
  <arg name="publish_map_tf" default="false"/>
  <arg name="enable_lidar" default="true"/>
  <arg name="enable_semantic_camera" default="$(eval arg('stream_profile') == 'development')"/>
  <arg name="lidar_model"  default="VLP-16"/>
  <arg name="lidar_rotation_rate" default="10.0"/>
  <!-- azimuth detects physical revolutions and works with both v2 and v3. -->
  <arg name="lidar_frame_mode" default="azimuth"/>
  <arg name="publish_lidar_tf" default="true"/>
  <!-- config/morai/sensors/ASMC_sensor_set_v2.json Lidar3D pose -->
  <arg name="lidar_x" default="0.80"/>
  <arg name="lidar_y" default="0.0"/>
  <arg name="lidar_z" default="1.45"/>
  <arg name="lidar_roll" default="0.0"/>
  <arg name="lidar_pitch" default="0.0"/>
  <arg name="lidar_yaw" default="0.0"/>

  <node pkg="morai_sensor_bridge" type="morai_sensor_bridge.py"
        name="morai_sensor_bridge" output="screen">
    <param name="runtime_profile" value="$(arg runtime_profile)"/>
    <param name="transport_profile" value="$(arg transport_profile)"/>
    <param name="stream_profile" value="$(arg stream_profile)"/>
    <param name="enable_camera" value="true"/>
    <param name="enable_semantic_camera" value="$(arg enable_semantic_camera)"/>
    <param name="enable_lidar"  value="$(arg enable_lidar)"/>
    <param name="enable_gps"    value="true"/>
    <param name="enable_imu"    value="true"/>
    <param name="publish_raw_image" value="false"/>

    <param name="gps_port"   value="$(arg gps_port)"/>
    <param name="imu_port"   value="$(arg imu_port)"/>
    <param name="planner_forward_ip" value="$(arg planner_forward_ip)"/>
    <param name="planner_gps_port"   value="$(arg planner_gps_port)"/>
    <param name="planner_imu_port"   value="$(arg planner_imu_port)"/>
    <param name="gps_east_offset"  value="$(arg gps_east_offset)"/>
    <param name="gps_north_offset" value="$(arg gps_north_offset)"/>
    <param name="publish_map_tf" value="$(arg publish_map_tf)"/>
    <param name="lidar_port" value="$(arg lidar_port)"/>
    <param name="lidar_topic" value="$(arg lidar_topic)"/>
    <param name="lidar_host_port" value="$(arg lidar_host_port)"/>
    <param name="enable_instance_lidar" value="$(arg enable_instance_lidar)"/>
    <param name="instance_lidar_port" value="$(arg instance_lidar_port)"/>
    <param name="instance_lidar_topic" value="$(arg instance_lidar_topic)"/>
    <param name="timestamp_mode" value="$(arg timestamp_mode)"/>
    <param name="lidar_model" value="$(arg lidar_model)"/>
    <param name="lidar_rotation_rate" value="$(arg lidar_rotation_rate)"/>
    <param name="lidar_frame_mode" value="$(arg lidar_frame_mode)"/>
    <param name="lidar_packets_per_frame" value="0"/>

    <!-- RGB Dest: 9291 / 9293 / 9295 / 9297 -->
    <rosparam param="cameras">
      - {name: cam1, port: 9291, topic: /image_jpeg/compressed, frame: camera_front}
      - {name: cam2, port: 9293, topic: /cam_left/image_jpeg/compressed, frame: camera_left}
      - {name: cam3, port: 9295, topic: /cam_right/image_jpeg/compressed, frame: camera_right}
      - {name: cam4, port: 9297, topic: /cam_extra/image_jpeg/compressed, frame: camera_extra}
    </rosparam>
    <!-- Semantic Dest: 9305 / 9307 / 9309 (ASMC_sensor_set_GT.json cameraType=1) -->
    <rosparam param="semantic_cameras">
      - {name: sem_front, port: 9305, topic: /sem_front/image_jpeg/compressed, frame: camera_front_semantic}
      - {name: sem_left,  port: 9307, topic: /sem_left/image_jpeg/compressed,  frame: camera_left_semantic}
      - {name: sem_right, port: 9309, topic: /sem_right/image_jpeg/compressed, frame: camera_right_semantic}
    </rosparam>
  </node>

  <node if="$(arg publish_lidar_tf)"
        pkg="tf2_ros" type="static_transform_publisher"
        name="base_to_velodyne"
        args="$(arg lidar_x) $(arg lidar_y) $(arg lidar_z)
              $(arg lidar_yaw) $(arg lidar_pitch) $(arg lidar_roll)
              base_link velodyne"/>
</launch>
