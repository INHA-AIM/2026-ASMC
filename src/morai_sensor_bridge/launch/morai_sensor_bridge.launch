<launch>
  <!-- AIM06 Sensor Dest: cam1–4 / GPS / IMU (Host/Dest 표의 Destination) -->
  <!-- Dest: cam→gps→imu→lidar. 9299는 Docker Desktop이 Windows에서 자주 미개방. -->
  <arg name="lidar_port"      default="9311"/>
  <arg name="lidar_host_port" default="0"/>
  <arg name="gps_port"        default="9301"/>
  <arg name="imu_port"        default="9303"/>
  <arg name="enable_lidar" default="true"/>
  <arg name="lidar_model"  default="VLP-16"/>
  <arg name="lidar_rotation_rate" default="10.0"/>
  <arg name="publish_lidar_tf" default="true"/>
  <!-- ASMC_sensor_set_v1.json Lidar3D pose -->
  <arg name="lidar_x" default="0.80"/>
  <arg name="lidar_y" default="0.0"/>
  <arg name="lidar_z" default="1.45"/>
  <arg name="lidar_roll" default="0.0"/>
  <arg name="lidar_pitch" default="0.0"/>
  <arg name="lidar_yaw" default="0.0"/>

  <node pkg="morai_sensor_bridge" type="morai_sensor_bridge.py"
        name="morai_sensor_bridge" output="screen">
    <param name="enable_camera" value="true"/>
    <param name="enable_lidar"  value="$(arg enable_lidar)"/>
    <param name="enable_gps"    value="true"/>
    <param name="enable_imu"    value="true"/>
    <param name="publish_raw_image" value="false"/>

    <param name="gps_port"   value="$(arg gps_port)"/>
    <param name="imu_port"   value="$(arg imu_port)"/>
    <param name="lidar_port" value="$(arg lidar_port)"/>
    <param name="lidar_host_port" value="$(arg lidar_host_port)"/>
    <param name="lidar_model" value="$(arg lidar_model)"/>
    <param name="lidar_rotation_rate" value="$(arg lidar_rotation_rate)"/>
    <param name="lidar_packets_per_frame" value="0"/>

    <!-- Dest: 9291 / 9293 / 9295 / 9297 -->
    <rosparam param="cameras">
      - {name: cam1, port: 9291, topic: /image_jpeg/compressed, frame: camera_front}
      - {name: cam2, port: 9293, topic: /cam_left/image_jpeg/compressed, frame: camera_left}
      - {name: cam3, port: 9295, topic: /cam_right/image_jpeg/compressed, frame: camera_right}
      - {name: cam4, port: 9297, topic: /cam_extra/image_jpeg/compressed, frame: camera_extra}
    </rosparam>
  </node>

  <node if="$(arg publish_lidar_tf)"
        pkg="tf2_ros" type="static_transform_publisher"
        name="base_to_velodyne"
        args="$(arg lidar_x) $(arg lidar_y) $(arg lidar_z)
              $(arg lidar_yaw) $(arg lidar_pitch) $(arg lidar_roll)
              base_link velodyne"/>
</launch>
