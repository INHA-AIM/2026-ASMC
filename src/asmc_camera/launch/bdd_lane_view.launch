<launch>
  <!-- Reuse the timestamp-exact semantic renderer, without BEV/family nodes. -->
  <node pkg="asmc_camera" type="semantic_visualizer_node.py" name="camera_lane_bdd_view" output="screen">
    <rosparam command="load" file="$(find asmc_camera)/config/camera/cameras.yaml"/>
    <rosparam command="load" file="$(find asmc_camera)/config/camera/visualization.yaml"/>
    <rosparam param="views">[left, front, right]</rosparam>
    <param name="secondary_mode" value="lane"/>
    <param name="condition_label" value="BDD100K Large · binary lane (not yellow class)"/>
    <remap from="/perception/camera/front/drivable/probability" to="/experiments/twinlite_bdd/front/drivable/probability"/>
    <remap from="/perception/camera/left/drivable/probability" to="/experiments/twinlite_bdd/left/drivable/probability"/>
    <remap from="/perception/camera/right/drivable/probability" to="/experiments/twinlite_bdd/right/drivable/probability"/>
    <remap from="/perception/camera/front/lane/probability" to="/experiments/twinlite_bdd/front/lane/probability"/>
    <remap from="/perception/camera/left/lane/probability" to="/experiments/twinlite_bdd/left/lane/probability"/>
    <remap from="/perception/camera/right/lane/probability" to="/experiments/twinlite_bdd/right/lane/probability"/>
    <remap from="/perception/camera/debug/mosaic/compressed" to="/experiments/twinlite_bdd/debug/mosaic/compressed"/>
  </node>
</launch>
