<launch>
  <arg name="managed" default="true"/>
  <arg name="initial_mode" default="0"/>
  <arg name="target_hz" default="20.0"/>
  <arg name="config" default="$(find asmc_camera)/config/camera/yolo11m_coco.yaml"/>
  <node pkg="asmc_camera" type="object_detection_node.py" name="camera_object_detector"
        output="screen" required="false" launch-prefix="$(optenv ASMC_YOLO_PYTHON)">
    <param name="managed" value="$(arg managed)"/>
    <param name="initial_mode" value="$(arg initial_mode)"/>
    <param name="target_hz" value="$(arg target_hz)"/>
    <rosparam command="load" file="$(arg config)" subst_value="true"/>
    <rosparam command="load" file="$(find asmc_camera)/config/camera/object_classes.yaml"/>
  </node>
</launch>
