<launch>
  <arg name="managed" default="true"/>
  <arg name="initial_mode" default="0"/>
  <arg name="target_hz" default="20.0"/>
  <arg name="config" default="$(find asmc_camera)/config/camera/yolo11m_coco.yaml"/>
  <arg name="class_groups_config" default="$(find asmc_camera)/config/camera/object_classes.yaml"/>
  <arg name="objects_hood_mask" default="true"/>
  <arg name="objects_side_ego_mask" default="true"/>
  <arg name="objects_left_ego_mask_config" default="$(find asmc_camera)/config/camera/yolo_ego_mask_left_v1.yaml"/>
  <arg name="objects_right_ego_mask_config" default="$(find asmc_camera)/config/camera/yolo_ego_mask_right_v1.yaml"/>
  <arg name="objects_ego_hood_filter" default="false"/>
  <arg name="objects_ego_hood_filter_config" default="$(find asmc_camera)/config/camera/yolo_ego_hood_filter_v1.yaml"/>
  <arg name="objects_debug_raw" default="false"/>
  <arg name="objects_debug_masks" default="false"/>
  <arg name="views" default=""/>
  <arg name="objects_hood_mask_config" default="$(find asmc_camera)/config/camera/yolo_hood_mask_v1.yaml"/>
  <node pkg="asmc_camera" type="object_detection_node.py" name="camera_object_detector"
        output="screen" required="false" launch-prefix="$(optenv ASMC_YOLO_PYTHON)">
    <param name="managed" value="$(arg managed)"/>
    <param name="initial_mode" value="$(arg initial_mode)"/>
    <param name="target_hz" value="$(arg target_hz)"/>
    <rosparam command="load" file="$(arg config)" subst_value="true"/>
    <rosparam command="load" file="$(arg class_groups_config)"/>
    <param name="hood_mask" type="bool" value="$(arg objects_hood_mask)"/>
    <param name="side_ego_mask" type="bool" value="$(arg objects_side_ego_mask)"/>
    <rosparam param="side_ego_mask_configs" subst_value="true">
      left: $(arg objects_left_ego_mask_config)
      right: $(arg objects_right_ego_mask_config)
    </rosparam>
    <param name="ego_hood_filter" type="bool" value="$(arg objects_ego_hood_filter)"/>
    <param name="ego_hood_filter_config" value="$(arg objects_ego_hood_filter_config)"/>
    <param name="debug_raw" type="bool" value="$(arg objects_debug_raw)"/>
    <param name="debug_masks" type="bool" value="$(arg objects_debug_masks)"/>
    <rosparam param="views" subst_value="true" if="$(eval arg('views') != '')">$(arg views)</rosparam>
    <param name="hood_mask_config" value="$(arg objects_hood_mask_config)"/>
  </node>
</launch>
