<launch>
  <!-- Experiment only: no changes to the selected COCO7 operational baseline. -->
  <arg name="model" default="m" doc="m or l; explicit prepared checkpoint-specific config"/>
  <arg name="front_width" default="960" doc="640, 960 or 1280; source image/FOV unchanged"/>
  <arg name="profile" default="debug"/>
  <arg name="objects_conf_thres" default=""/>
  <arg name="start_camera_lane" default="false"/>
  <arg name="start_traffic_light" default="false"/>
  <include file="$(find asmc_camera)/launch/camera_coco7.launch">
    <arg name="profile" value="$(arg profile)"/>
    <arg name="camera_objects_config" value="$(find asmc_camera)/config/camera/yoloe_selection/$(arg model)_$(arg front_width).yaml"/>
    <arg name="objects_conf_thres" value="$(arg objects_conf_thres)"/>
    <arg name="start_camera_lane" value="$(arg start_camera_lane)"/>
    <arg name="start_traffic_light" value="$(arg start_traffic_light)"/>
  </include>
</launch>
