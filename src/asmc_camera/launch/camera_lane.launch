<launch>
  <arg name="component_config" default=""/>
  <arg name="input_config" default=""/>
  <arg name="node_name" default="camera_semantic_inference"/>
  <arg name="managed" default="true"/>
  <arg name="initial_mode" default="0"/>
  <arg name="target_hz" default="10.0"/>
  <!-- Canonical P4-C camera runtime. Implementation, support modules and
       runtime configuration are owned by asmc_camera. -->
  <arg name="views" default="front, left, right"/>
  <arg name="checkpoint"
       default="$(find asmc_camera)/models/lane_segmentation/twinlite-medium-v6.pt"/>
  <arg name="device" default="cuda"/>
  <arg name="amp" default="true"/>
  <arg name="warmup_iterations" default="1"/>
  <arg name="batch_wait_ms" default="4.0"/>
  <arg name="publish_model_grid_road_marking" default="false"/>
  <arg name="model_grid_max_hz" default="10.0"/>

  <!-- RTX 50: ASMC_LANE_PYTHON=/opt/yolo-venv/bin/python selects the cu128 runtime.
       Unset keeps the default interpreter. -->
  <node pkg="asmc_camera" type="semantic_inference_node.py"
        name="$(arg node_name)" output="screen" required="$(eval not arg('managed'))"
        launch-prefix="$(optenv ASMC_LANE_PYTHON)">
    <param name="managed" value="$(arg managed)"/>
    <param name="initial_mode" value="$(arg initial_mode)"/>
    <param name="target_hz" value="$(arg target_hz)"/>
    <rosparam command="load"
              file="$(find asmc_camera)/config/camera/cameras.yaml"/>
    <rosparam command="load"
              file="$(find asmc_camera)/config/camera/twinlite_medium.yaml"/>
    <rosparam param="views" subst_value="true">[$(arg views)]</rosparam>
    <param name="checkpoint" value="$(arg checkpoint)" if="$(eval arg('component_config') == '')"/>
    <param name="device" value="$(arg device)"/>
    <param name="amp" value="$(arg amp)"/>
    <param name="warmup_iterations" value="$(arg warmup_iterations)"/>
    <param name="batch_wait_ms" value="$(arg batch_wait_ms)"/>
    <param name="publish_model_grid_road_marking"
           value="$(arg publish_model_grid_road_marking)"/>
    <param name="model_grid_max_hz" value="$(arg model_grid_max_hz)"/>
    <rosparam command="load" file="$(arg component_config)" subst_value="true" if="$(eval arg('component_config') != '')"/>
    <rosparam command="load" file="$(arg input_config)" if="$(eval arg('input_config') != '')"/>
    <param name="target_hz" value="$(arg target_hz)"/>
  </node>
</launch>
