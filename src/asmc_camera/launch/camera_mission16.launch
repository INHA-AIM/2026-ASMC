<launch>
  <arg name="profile" default="debug"/>
  <arg name="objects_conf_thres" default="0.40"/>
  <arg name="camera_objects_config" default="$(find asmc_camera)/config/camera/yolo26l_mission16_e8_three_view.yaml"/>
  <arg name="start_camera_lane" default="false"/>
  <arg name="start_traffic_light" default="false"/>
  <arg name="start_visualization" default="$(eval arg('profile') == 'debug')"/>
  <include file="$(find asmc_camera)/launch/perception.launch">
    <arg name="profile" value="$(arg profile)"/>
    <arg name="camera_objects_config" value="$(arg camera_objects_config)"/>
    <arg name="objects_class_groups_config" value="$(find asmc_camera)/config/camera/object_classes_mission16_v1.yaml"/>
    <arg name="objects_conf_thres" value="$(arg objects_conf_thres)"/>
    <arg name="objects_target_hz" value="15.0"/>
    <arg name="objects_views" value="[front,left,right]"/>
    <arg name="objects_hood_mask" value="true"/>
    <arg name="objects_side_ego_mask" value="true"/>
    <arg name="start_camera_lane" value="$(arg start_camera_lane)"/>
    <arg name="start_traffic_light" value="$(arg start_traffic_light)"/>
    <arg name="start_visualization" value="$(arg start_visualization)"/>
  </include>
</launch>
