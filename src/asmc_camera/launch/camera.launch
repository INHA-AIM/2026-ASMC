<launch>
  <arg name="mode" default="standby" doc="off | standby | active"/>
  <arg name="models" default="all" doc="all or comma-separated objects,lane,traffic_light"/>
  <arg name="detector" default="e8" doc="e8 | pretrained; restart to change weights"/>
  <arg name="confidence" default="0.40"/>
  <arg name="nms_iou" default="0.70"/>
  <include file="$(find asmc_camera)/launch/_runtime.launch">
    <arg name="mode" value="$(arg mode)"/><arg name="models" value="$(arg models)"/>
    <arg name="detector" value="$(arg detector)"/><arg name="confidence" value="$(arg confidence)"/>
    <arg name="nms_iou" value="$(arg nms_iou)"/>
  </include>
</launch>
