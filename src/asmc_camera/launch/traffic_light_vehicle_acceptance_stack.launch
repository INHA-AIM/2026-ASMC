<launch>
  <arg name="run_acceptance" default="false"/>
  <arg name="allow_vehicle_control" default="false"/>
  <arg name="repo_root" default="/root/ws"/>
  <arg name="grpc_host" default="host.docker.internal"/>

  <!-- Physical MORAI acceptance stack.  Unlike the deterministic decision
       test, this launch publishes /ctrl_cmd through Frenet and MPC.  It never
       starts a bridge, so an already verified asmc_bridge instance is required.
       Use only with the simulator in a controlled test scene. -->
  <node pkg="frenet_planner" type="empty_objects_test_publisher"
        name="traffic_light_acceptance_empty_objects" output="screen"/>
  <include file="$(find behavior_planner)/launch/behavior_node_v2.launch">
    <arg name="dashboard" value="false"/>
  </include>
  <include file="$(find frenet_planner)/launch/frenet_planner.launch"/>
  <!-- Keep MPC output physically isolated until the acceptance node captures
       the original Ego state and opens its explicit forwarding gate. -->
  <group>
    <remap from="/ctrl_cmd" to="/acceptance/ctrl_cmd"/>
    <include file="$(find mpc_controller)/launch/mpc_controller.launch"/>
  </group>

  <!-- Opt-in only.  The default launch is safe for graph inspection and does
       not teleport or control Ego.  When enabled, death of the required test
       node shuts down Frenet/MPC before the operator resumes manual driving. -->
  <node if="$(arg run_acceptance)" required="true"
        pkg="asmc_perception" type="traffic_light_vehicle_acceptance.py"
        name="traffic_light_vehicle_acceptance" output="screen">
    <param name="allow_vehicle_control" value="$(arg allow_vehicle_control)"/>
    <param name="repo_root" value="$(arg repo_root)"/>
    <param name="grpc_host" value="$(arg grpc_host)"/>
  </node>
</launch>
