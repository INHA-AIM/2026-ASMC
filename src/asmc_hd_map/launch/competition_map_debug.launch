<launch>
  <!-- Reviewed markings/metadata plus the P2-B compact drivable product. -->
  <arg name="rviz" default="true"/>
  <arg name="data_root" default="/data"/>
  <arg name="debug_republish_hz" default="1.0"/>
  <arg name="map_path"
       default="$(find asmc_hd_map)/reports/kcity2025_route_curation_20260917/route_curated_candidate_map.json"/>
  <arg name="metadata_path"
       default="$(find asmc_hd_map)/config/kcity2025_competition_metadata.yaml"/>
  <arg name="drivable_product_path"
       default="$(find asmc_hd_map)/config/kcity2025_compact_drivable_map.json"/>
  <arg name="baseline_path" default=""/>
  <arg name="publish_local" default="true"/>
  <arg name="local_pose_source" default="gps_imu"/>
  <arg name="local_ego_topic" default="/Ego_topic"/>
  <arg name="local_pose_topic" default="/localization/pose"/>
  <arg name="local_gps_topic" default="/gps"/>
  <arg name="local_imu_topic" default="/imu"/>
  <arg name="local_extent_m" default="120.0"/>
  <arg name="local_publish_hz" default="5.0"/>

  <node pkg="asmc_hd_map" type="competition_map_publisher_node.py"
        name="competition_map_publisher" output="screen" required="true">
    <param name="map_path" value="$(arg map_path)"/>
    <param name="metadata_path" value="$(arg metadata_path)"/>
    <param name="drivable_product_path" value="$(arg drivable_product_path)"/>
    <param name="baseline_path" value="$(arg baseline_path)"/>
    <param name="data_root" value="$(arg data_root)"/>
    <param name="debug_republish_hz" value="$(arg debug_republish_hz)"/>
  </node>

  <node if="$(arg publish_local)" pkg="asmc_hd_map" type="local_map_crop_node.py"
        name="local_map_crop" output="screen" required="true">
    <param name="pose_source" value="$(arg local_pose_source)"/>
    <param name="ego_topic" value="$(arg local_ego_topic)"/>
    <param name="pose_topic" value="$(arg local_pose_topic)"/>
    <param name="gps_topic" value="$(arg local_gps_topic)"/>
    <param name="imu_topic" value="$(arg local_imu_topic)"/>
    <param name="map_path" value="$(arg map_path)"/>
    <param name="utm_epsg" value="32652"/>
    <param name="gps_lever_arm_x_m" value="0.35"/>
    <param name="gps_lever_arm_y_m" value="0.0"/>
    <param name="maximum_gps_imu_gap_ms" value="100.0"/>
    <param name="gps_offset_tolerance_m" value="1.0"/>
    <param name="extent_m" value="$(arg local_extent_m)"/>
    <param name="publish_hz" value="$(arg local_publish_hz)"/>
  </node>

  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="competition_map_debug_rviz"
        args="-d $(find asmc_hd_map)/rviz/competition_map_debug.rviz"/>
</launch>
