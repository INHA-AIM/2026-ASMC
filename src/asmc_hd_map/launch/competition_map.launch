<launch>
  <!-- Canonical runtime entry point. The debug marker topic is read-only and
       may be disabled by launching with rviz:=false (the default). -->
  <arg name="rviz" default="false"/>
  <arg name="data_root" default="/data"/>
  <arg name="debug_republish_hz" default="0.0"/>
  <arg name="debug_marker_detail" default="lite"/>
  <arg name="baseline_path" default=""/>
  <arg name="publish_local" default="false"/>
  <arg name="local_pose_source" default="gps_imu"/>
  <arg name="local_ego_topic" default="/Ego_topic"/>
  <arg name="local_pose_topic" default="/localization/pose"/>
  <arg name="local_gps_topic" default="/gps"/>
  <arg name="local_imu_topic" default="/imu"/>
  <arg name="local_extent_m" default="120.0"/>
  <arg name="local_crop_mode" default="ego"/>
  <arg name="local_front_m" default="90.0"/>
  <arg name="local_rear_m" default="30.0"/>
  <arg name="local_left_m" default="30.0"/>
  <arg name="local_right_m" default="30.0"/>
  <arg name="local_publish_hz" default="20.0"/>
  <arg name="follow_ego" default="true"/>

  <include file="$(find asmc_hd_map)/launch/competition_map_debug.launch">
    <arg name="rviz" value="$(arg rviz)"/>
    <arg name="data_root" value="$(arg data_root)"/>
    <arg name="debug_republish_hz" value="$(arg debug_republish_hz)"/>
    <arg name="debug_marker_detail" value="$(arg debug_marker_detail)"/>
    <arg name="baseline_path" value="$(arg baseline_path)"/>
    <arg name="publish_local" value="$(arg publish_local)"/>
    <arg name="local_pose_source" value="$(arg local_pose_source)"/>
    <arg name="local_ego_topic" value="$(arg local_ego_topic)"/>
    <arg name="local_pose_topic" value="$(arg local_pose_topic)"/>
    <arg name="local_gps_topic" value="$(arg local_gps_topic)"/>
    <arg name="local_imu_topic" value="$(arg local_imu_topic)"/>
    <arg name="local_extent_m" value="$(arg local_extent_m)"/>
    <arg name="local_crop_mode" value="$(arg local_crop_mode)"/>
    <arg name="local_front_m" value="$(arg local_front_m)"/>
    <arg name="local_rear_m" value="$(arg local_rear_m)"/>
    <arg name="local_left_m" value="$(arg local_left_m)"/>
    <arg name="local_right_m" value="$(arg local_right_m)"/>
    <arg name="local_publish_hz" value="$(arg local_publish_hz)"/>
    <arg name="follow_ego" value="$(arg follow_ego)"/>
  </include>
</launch>
