Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.45
      Cell Size: 5
      Class: rviz/Grid
      Color: 80; 90; 100
      Enabled: true
      Name: Metric grid
      Plane: XY
      Reference Frame: base_link
    - Class: rviz/MarkerArray
      Enabled: false
      Marker Topic: /asmc_hd_map/review/observed_calibrated_boundaries
      Name: Observed calibration (validation only)
      Queue Size: 2
    - Class: rviz/MarkerArray
      Enabled: false
      Marker Topic: /asmc_hd_map/review/nominal_boundaries
      Name: Current nominal boundaries (fallback reference)
      Queue Size: 2
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /asmc_hd_map/review/adopted_legacy_boundaries
      Name: Reviewed hybrid boundaries (candidate)
      Queue Size: 2
    - Class: rviz/MarkerArray
      Enabled: false
      Marker Topic: /asmc_hd_map/review/changed_region_legacy_candidates
      Name: Changed-region legacy (review only)
      Queue Size: 2
    - Class: rviz/MarkerArray
      Enabled: false
      Marker Topic: /asmc_hd_map/review/legacy_ab_reference_lanes
      Name: Legacy A/B references (not merged)
      Queue Size: 2
    - Class: rviz/MarkerArray
      Enabled: false
      Marker Topic: /asmc_hd_map/review/source_observations
      Name: Raw source observations
      Queue Size: 2
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /asmc_hd_map/review/current_link_centers
      Name: Current link centers
      Queue Size: 2
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /asmc_hd_map/review/competition_route
      Name: Organizer route
      Queue Size: 2
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /asmc_hd_map/review/stopline_candidates
      Name: Stopline candidates
      Queue Size: 2
    - Class: rviz/MarkerArray
      Enabled: false
      Marker Topic: /asmc_hd_map/review/high_speed_link_labels
      Name: High-speed link IDs
      Queue Size: 2
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /asmc_hd_map/review/ego_context
      Name: Ego footprint
      Queue Size: 2
  Enabled: true
  Global Options:
    Background Color: 15; 18; 22
    Fixed Frame: base_link
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
  Views:
    Current:
      Angle: 0
      Class: rviz/TopDownOrtho
      Name: Ego top-down
      Scale: 45
      Target Frame: base_link
      X: 20
      Y: 0
Window Geometry:
  Height: 900
  Width: 1250
