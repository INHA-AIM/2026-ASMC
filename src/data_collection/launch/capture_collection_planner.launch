<launch>
  <remap from="/ctrl_cmd_0" to="/collection/lidar_unused_ctrl"/>
  <!-- Existing team planner/Main; collection state is isolated from competition state. -->
  <include file="$(find asmc_hd_map)/launch/competition_map.launch">
    <arg name="rviz" value="false"/>
    <arg name="publish_local" value="false"/>
  </include>
  <include file="$(find Main)/main.launch">
    <arg name="start_yolo" value="false"/>
    <arg name="rviz" value="false"/>
    <arg name="start_velodyne_driver" value="false"/>
  </include>
  <include file="$(find planning_inputs)/launch/objects.launch">
    <arg name="input_topic" value="/last_lidar"/>
    <arg name="source_policy" value="validated_lidar"/>
    <arg name="state_topic" value="/collection/vehicle/state"/>
    <arg name="output_topic" value="/planning/objects"/>
  </include>
  <include file="$(find asmc_planner)/launch/planner_v2.launch">
    <arg name="state_topic" value="/collection/vehicle/state"/>
    <arg name="objects_input_type" value="detected"/>
    <arg name="behavior_objects_topic" value="/planning/objects"/>
    <arg name="planning_objects_topic" value="/planning/objects"/>
  </include>
</launch>
