<launch>
  <!-- Obstacle-free KEEP E2E based on keep_morai_no_obstacles.launch. -->
  <arg name="state_source" default="gps_imu" doc="gps_imu or ego_dev"/>
  <arg name="dashboard" default="false"/>
  <arg name="traffic_light" default="true"/>
  <arg name="traffic_light_device" default="auto"/>
  <arg name="camera_topic" default="/cam_extra/image_jpeg/compressed"/>
  <arg name="traffic_light_checkpoint"
       default="$(find asmc_perception)/models/traffic_light/best.pt"/>

  <!-- MORAI bridges are intentionally not started here. -->
  <group if="$(arg traffic_light)">
    <!-- P4-C3 migration: implementation now lives in asmc_perception. Keep
         the old topic names until all external consumers have cut over. -->
    <node pkg="asmc_perception" type="traffic_light_node.py"
          name="traffic_light_infer" output="screen"
          args="--ckpt $(arg traffic_light_checkpoint) --image-topic $(arg camera_topic) --state-topic /traffic_light/state --detail-topic /traffic_light/detail --typed-topic /perception/traffic_light/detection --device $(arg traffic_light_device)"/>
  </group>

  <include if="$(eval arg('state_source') == 'gps_imu')"
           file="$(find asmc_bridge)/launch/vehicle_state.launch"/>
  <include if="$(eval arg('state_source') == 'ego_dev')"
           file="$(find asmc_bridge)/launch/vehicle_state_ego_dev.launch"/>

  <node pkg="frenet_planner" type="empty_objects_test_publisher"
        name="empty_objects_test_publisher" output="screen"/>
  <include file="$(find behavior_planner)/launch/behavior_node.launch">
    <arg name="dashboard" value="$(arg dashboard)"/>
  </include>
  <include file="$(find frenet_planner)/launch/frenet_planner.launch"/>
  <include file="$(find mpc_controller)/launch/mpc_controller.launch"/>
</launch>
