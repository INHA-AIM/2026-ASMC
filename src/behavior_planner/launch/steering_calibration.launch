<launch>
  <!-- Autonomy/MPC must be stopped. Use only in a clear, flat open area. -->
  <arg name="armed" default="false"/>
  <arg name="steering_deg" default="20.0"/>
  <arg name="target_speed_mps" default="2.5"/>
  <arg name="speed_deadband_mps" default="0.2"/>
  <arg name="approach_accel" default="0.18"/>
  <arg name="hold_accel" default="0.08"/>
  <arg name="hold_brake" default="0.05"/>
  <arg name="straight_roll_s" default="1.0"/>
  <arg name="settle_time_s" default="4.0"/>
  <arg name="sample_time_s" default="8.0"/>
  <arg name="max_speed_mps" default="4.0"/>
  <arg name="max_trial_time_s" default="45.0"/>
  <arg name="bag_path" default=""/>

  <node pkg="behavior_planner" type="steering_calibration_node.py"
        name="steering_calibration" output="screen" required="true">
    <param name="armed" value="$(arg armed)"/>
    <param name="steering_deg" value="$(arg steering_deg)"/>
    <param name="target_speed_mps" value="$(arg target_speed_mps)"/>
    <param name="speed_deadband_mps" value="$(arg speed_deadband_mps)"/>
    <param name="approach_accel" value="$(arg approach_accel)"/>
    <param name="hold_accel" value="$(arg hold_accel)"/>
    <param name="hold_brake" value="$(arg hold_brake)"/>
    <param name="straight_roll_s" value="$(arg straight_roll_s)"/>
    <param name="settle_time_s" value="$(arg settle_time_s)"/>
    <param name="sample_time_s" value="$(arg sample_time_s)"/>
    <param name="max_speed_mps" value="$(arg max_speed_mps)"/>
    <param name="max_trial_time_s" value="$(arg max_trial_time_s)"/>
    <param name="bag_path" value="$(arg bag_path)"/>
  </node>
</launch>
