<launch>
  <arg name="state_topic" default="/vehicle/state"/>
  <arg name="dashboard" default="true"/>
  <arg name="open_dashboard" default="false"/>
  <arg name="dashboard_port" default="8088"/>
  <arg name="rviz" default="false"/>
  <arg name="objects_input_type" default="morai"/>
  <arg name="objects_topic" default="/Object_topic"/>
  <arg name="dashboard_lidar_objects_topic"
       default="/perception/objects_lidar_test"/>
  <arg name="dashboard_lidar_motion_debug_topic"
       default="/lidar/motion_debug"/>
  <arg name="avoid_path_margin_m" default="0.4"/>

  <!-- Same behavior_node executable; only the ROS boundary is switched to
       BehaviorCommand/FrenetFeedback v2. -->
  <include file="$(find behavior_planner)/launch/behavior_node.launch">
    <arg name="interface_version" value="v2"/>
    <arg name="state_topic" value="$(arg state_topic)"/>
    <arg name="objects_input_type" value="$(arg objects_input_type)"/>
    <arg name="objects_topic" value="$(arg objects_topic)"/>
    <arg name="dashboard_page" value="index_v2.html"/>
    <arg name="dashboard" value="$(arg dashboard)"/>
    <arg name="open_dashboard" value="$(arg open_dashboard)"/>
    <arg name="dashboard_port" value="$(arg dashboard_port)"/>
    <arg name="dashboard_lidar_objects_topic"
         value="$(arg dashboard_lidar_objects_topic)"/>
    <arg name="dashboard_lidar_motion_debug_topic"
         value="$(arg dashboard_lidar_motion_debug_topic)"/>
    <arg name="avoid_path_margin_m" value="$(arg avoid_path_margin_m)"/>
    <arg name="rviz" value="$(arg rviz)"/>
  </include>
</launch>
