<?xml version="1.0"?>
<package format="2">
  <name>drivable_bev</name>
  <version>0.1.0</version>
  <description>Metric ego-frame camera semantic BEV pilot for MORAI.</description>

  <maintainer email="autonav@todo.todo">autonav</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <!-- Compatibility/offline package: runtime support moved to asmc_perception. -->
  <exec_depend>asmc_perception</exec_depend>

  <depend>diagnostic_msgs</depend>
  <depend>asmc_msgs</depend>
  <depend>camera_semantic_perception</depend>
  <depend>geometry_msgs</depend>
  <depend>message_filters</depend>
  <depend>morai_msgs</depend>
  <depend>rospy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>data_collection</exec_depend>
  <exec_depend>rosbag</exec_depend>

  <test_depend>python3-nose</test_depend>
</package>
