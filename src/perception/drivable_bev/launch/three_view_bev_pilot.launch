<launch>
  <arg name="checkpoint"
       default="/root/ws/artifacts/perception_eval/runs/twinlite_medium_morai_v6_road_marking_init_b_b12_e18_20260908/best_mean.pt"/>
  <arg name="device" default="cuda"/>
  <arg name="warmup_iterations" default="1"/>
  <arg name="batch_wait_ms" default="20.0"/>
  <arg name="start_inference" default="true"/>
  <arg name="start_visualizer" default="true"/>
  <arg name="publish_per_view_mosaic" default="false"/>
  <arg name="publish_model_grid_road_marking" default="false"/>
  <arg name="model_grid_max_hz" default="10.0"/>
  <arg name="verify_sensor_set" default="true"/>
  <arg name="sensor_set_path"
       default="$(find drivable_bev)/../../../config/morai/sensors/ASMC_sensor_set_v2.json"/>
  <arg name="bev_grid_config"
       default="$(find drivable_bev)/config/bev_grid.yaml"/>
  <arg name="visualization_config"
       default="$(find drivable_bev)/config/visualization.yaml"/>

  <include if="$(arg start_inference)"
           file="$(find camera_semantic_perception)/launch/three_view.launch">
    <arg name="checkpoint" value="$(arg checkpoint)"/>
    <arg name="device" value="$(arg device)"/>
    <arg name="warmup_iterations" value="$(arg warmup_iterations)"/>
    <arg name="batch_wait_ms" value="$(arg batch_wait_ms)"/>
    <arg name="publish_model_grid_road_marking"
         value="$(arg publish_model_grid_road_marking)"/>
    <arg name="model_grid_max_hz" value="$(arg model_grid_max_hz)"/>
  </include>

  <include file="$(find drivable_bev)/launch/camera_bev.launch">
    <arg name="views" value="front, left, right"/>
    <arg name="bev_grid_config" value="$(arg bev_grid_config)"/>
    <arg name="verify_sensor_set" value="$(arg verify_sensor_set)"/>
    <arg name="sensor_set_path" value="$(arg sensor_set_path)"/>
  </include>

  <include file="$(find drivable_bev)/launch/camera_bev_fusion.launch">
    <arg name="views" value="front, left, right"/>
    <arg name="bev_grid_config" value="$(arg bev_grid_config)"/>
  </include>

  <include if="$(arg start_visualizer)"
           file="$(find drivable_bev)/launch/camera_bev_visualizer.launch">
    <arg name="views" value="front, left, right"/>
    <arg name="publish_per_view_mosaic" value="$(arg publish_per_view_mosaic)"/>
    <arg name="bev_grid_config" value="$(arg bev_grid_config)"/>
    <arg name="visualization_config" value="$(arg visualization_config)"/>
  </include>
</launch>
