<launch>
  <!-- Evaluation-only consumer; it publishes no runtime boundary topic. -->
  <arg name="run_id"/>
  <arg name="output_dir"/>
  <arg name="pseudo_gt_path"
       default="$(find drivable_bev)/../../../artifacts/perception_eval/analysis/shadow_lane_map_pseudo_gt_pose_v4_20260914/shadow_lane_pseudo_gt.json"/>
  <arg name="overlay_stride" default="30"/>
  <arg name="overlay_limit" default="24"/>
  <arg name="high_residual_overlay_threshold_m" default="0.50"/>
  <arg name="high_residual_overlay_limit" default="100"/>
  <arg name="pseudo_gt_disagreement_m" default="0.50"/>
  <!-- Offline map-evaluation alignment only; this is not runtime ego-motion compensation. -->
  <arg name="ego_pose_alignment_mode" default="nearest"/>
  <arg name="ego_pose_max_age_ms" default="50.0"/>
  <arg name="ego_pose_max_bracket_ms" default="100.0"/>
  <!-- Disabled by default. Enable for sparse, measurement-only INVALID review. -->
  <arg name="invalid_support_overlay_limit_per_category" default="0"/>
  <arg name="invalid_support_overlay_min_frame_gap" default="15"/>
  <arg name="invalid_map_overlay_limit_per_category_band" default="0"/>
  <arg name="invalid_map_overlay_min_frame_gap" default="15"/>

  <node pkg="drivable_bev" type="shadow_lane_family_offline_node.py"
        name="shadow_lane_family_offline" output="screen" required="true">
    <rosparam command="load" file="$(find drivable_bev)/config/lane_fitting.yaml"/>
    <param name="run_id" value="$(arg run_id)"/>
    <param name="output_dir" value="$(arg output_dir)"/>
    <param name="pseudo_gt_path" value="$(arg pseudo_gt_path)"/>
    <param name="overlay_stride" value="$(arg overlay_stride)"/>
    <param name="overlay_limit" value="$(arg overlay_limit)"/>
    <param name="high_residual_overlay_threshold_m"
           value="$(arg high_residual_overlay_threshold_m)"/>
    <param name="high_residual_overlay_limit"
           value="$(arg high_residual_overlay_limit)"/>
    <param name="pseudo_gt_disagreement_m"
           value="$(arg pseudo_gt_disagreement_m)"/>
    <param name="ego_pose_alignment_mode" value="$(arg ego_pose_alignment_mode)"/>
    <param name="ego_pose_max_age_ms" value="$(arg ego_pose_max_age_ms)"/>
    <param name="ego_pose_max_bracket_ms" value="$(arg ego_pose_max_bracket_ms)"/>
    <param name="invalid_support_overlay_limit_per_category"
           value="$(arg invalid_support_overlay_limit_per_category)"/>
    <param name="invalid_support_overlay_min_frame_gap"
           value="$(arg invalid_support_overlay_min_frame_gap)"/>
    <param name="invalid_map_overlay_limit_per_category_band"
           value="$(arg invalid_map_overlay_limit_per_category_band)"/>
    <param name="invalid_map_overlay_min_frame_gap"
           value="$(arg invalid_map_overlay_min_frame_gap)"/>
  </node>
</launch>
