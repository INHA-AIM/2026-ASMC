<launch>
  <!-- Headless camera-to-boundary pipeline for raw-bag replay and runtime gates. -->
  <arg name="checkpoint"
       default="/root/ws/artifacts/perception_eval/runs/twinlite_medium_morai_v6_road_marking_init_b_b12_e18_20260908/best_mean.pt"/>
  <arg name="device" default="cuda"/>
  <arg name="warmup_iterations" default="1"/>
  <arg name="batch_wait_ms" default="20.0"/>
  <!-- The 15 Hz cap yields ~10 Hz vector output without a processing-p95
       regression; fused BEV remains capped independently at 10 Hz. -->
  <arg name="model_grid_max_hz" default="15.0"/>
  <arg name="verify_sensor_set" default="true"/>
  <arg name="sensor_set_path"
       default="$(find drivable_bev)/../../../config/ASMC_sensor_set_v2.json"/>
  <arg name="bev_grid_config"
       default="$(find drivable_bev)/config/bev_grid.yaml"/>
  <arg name="operating_domain" default="shadow_two_way_v1"/>
  <arg name="algorithm_id" default="twinlite_v6_shadow_boundary_contract_v1"/>
  <arg name="enable_shared_family_debug" default="false"/>
  <arg name="enable_boundary_family_candidate"
       default="$(arg enable_shared_family_debug)"/>

  <include file="$(find drivable_bev)/launch/three_view_bev_pilot.launch">
    <arg name="checkpoint" value="$(arg checkpoint)"/>
    <arg name="device" value="$(arg device)"/>
    <arg name="warmup_iterations" value="$(arg warmup_iterations)"/>
    <arg name="batch_wait_ms" value="$(arg batch_wait_ms)"/>
    <arg name="start_visualizer" value="false"/>
    <arg name="publish_per_view_mosaic" value="false"/>
    <arg name="publish_model_grid_road_marking" value="true"/>
    <arg name="model_grid_max_hz" value="$(arg model_grid_max_hz)"/>
    <arg name="verify_sensor_set" value="$(arg verify_sensor_set)"/>
    <arg name="sensor_set_path" value="$(arg sensor_set_path)"/>
    <arg name="bev_grid_config" value="$(arg bev_grid_config)"/>
  </include>

  <include file="$(find drivable_bev)/launch/lane_vector_pilot.launch">
    <arg name="views" value="front, left, right"/>
    <arg name="start_visualizer" value="false"/>
    <arg name="bev_grid_config" value="$(arg bev_grid_config)"/>
    <arg name="operating_domain" value="$(arg operating_domain)"/>
    <arg name="algorithm_id" value="$(arg algorithm_id)"/>
    <arg name="enable_shared_family_debug" value="$(arg enable_shared_family_debug)"/>
    <arg name="enable_boundary_family_candidate"
         value="$(arg enable_boundary_family_candidate)"/>
  </include>
</launch>
