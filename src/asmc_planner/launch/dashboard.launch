<launch>
  <!-- Observer-only ownership migration of the legacy dashboard group. -->
  <arg name="state_topic" default="/planning/vehicle/state"/>
  <arg name="dashboard_port" default="8088"/>
  <arg name="open_dashboard" default="false"/>
  <arg name="dashboard_lidar_objects_topic" default="/planning/objects"/>
  <!-- Current motion state is in typed planning objects. Historical JSON is opt-in. -->
  <arg name="dashboard_lidar_motion_debug_topic" default=""/>
  <node pkg="asmc_planner" type="behavior_dashboard_server.py"
        name="behavior_dashboard_server" output="screen">
    <remap from="/vehicle/state" to="$(arg state_topic)"/>
    <param name="port" value="$(arg dashboard_port)"/>
    <param name="package_path" value="$(find asmc_planner)"/>
    <param name="interface_version" value="v2"/>
    <param name="lidar_objects_topic" value="$(arg dashboard_lidar_objects_topic)"/>
    <param name="lidar_motion_debug_topic" value="$(arg dashboard_lidar_motion_debug_topic)"/>
  </node>
  <node if="$(arg open_dashboard)" pkg="asmc_planner" type="open_dashboard.py"
        name="behavior_dashboard_opener" output="screen">
    <param name="url" value="http://localhost:$(arg dashboard_port)/web/index_v2.html"/>
  </node>
</launch>
