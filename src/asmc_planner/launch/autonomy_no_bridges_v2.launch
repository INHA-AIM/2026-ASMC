<launch>
  <arg name="highway_merge" default="true"/>
  <arg name="dashboard" default="true"/>
  <arg name="open_dashboard" default="false"/>
  <arg name="jamming_planner" default="camera" doc="camera: main follower, local: observed local road, localization: map localization"/>
  <arg name="dashboard_port" default="8088"/>
  <arg name="jamming_speed_kph" default="$(eval {'camera':20.0,'local':20.0,'localization':15.0}[arg('jamming_planner')])"/>
  <arg name="localization_local_recovery" default="false" doc="Experimental validated LOCAL path fallback; localization retains the single MPC"/>
  <arg name="local_semantic_input" default="true"/>
  <arg name="local_planner_config" default="$(find asmc_planner)/config/local_planner.yaml"/>
  <arg name="local_forward_warning_weight" default=""/>
  <arg name="shadow_static_avoidance" default="$(eval arg('jamming_planner') == 'localization')" doc="Localization comparison profile: measured static bypass and return; see documented failures"/>
  <arg name="shadow_dynamic_obstacles" default="$(eval arg('jamming_planner') == 'localization')" doc="Localization comparison profile: observed-motion yield; not general dynamic acceptance"/>
  <arg name="shadow_lane_rules" default="$(eval arg('jamming_planner') == 'localization')" doc="verified shadow zone paint exemption; physical road stays hard"/>
  <arg name="jamming_run_id" default="$(eval arg('jamming_planner') + '-autonomy')"/>
  <arg name="shadow_run_id" default="$(arg jamming_run_id)" doc="Legacy run-id override; current code may use jamming_run_id"/>
  <arg name="shadow_speed_cap_kph" default="$(arg jamming_speed_kph)"/>
  <arg name="shadow_journal_path" default=""/>
  <arg name="shadow_start_motion" default="true"/>
  <arg name="shadow_motion_yaw_source" default="orientation"/>
  <arg name="shadow_motion_reference_offset_m" default="1.4"/>
  <arg name="shadow_motion_turn_gain_m2ps" default="1.54"/>
  <arg name="shadow_motion_topic" default="/planning/localization/motion"/>
  <!-- Integrated planner, input adapters and controller. Bridges and asmc_lidar
       remain separately managed. This wrapper currently supports LiDAR input. -->
  <arg name="state_source" default="competition" doc="competition, gps_imu or external"/>
  <arg name="state_topic" default="/planning/vehicle/state"/>
  <arg name="canonical_objects_topic" default="/planning/objects"/>
  <arg name="lidar_input_topic" default="/perception/lidar/planning_observations_map"/>
  <arg name="avoid_path_margin_m" default="0.4"/>
  <arg name="static_obstacle_unknown" default="true"/>
  <!-- 신호등 추론·발행은 카메라 담당의 asmc_camera/camera.launch가 단독 소유한다.
       판제는 /perception/traffic_light/detection을 소비하며 별도 ResNet을 시작하지 않는다.
       실행 중 중단·재개/주기는 카메라의 /perception/camera/traffic_light/set_mode
       (mode 0=STANDBY, 2=ACTIVE, target_hz 0=유지)로 제어한다. 단일 제어 소유자를 유지한다.
       판제 신호 규칙은 계속 동작하며 stale/invalid는 unknown으로 처리한다.
       See docs/handoffs/perception-to-planning.md. -->
  <!-- Current M1 hash/calibration are shared by follower and exact-image BBox
       projection. Closed-loop acceptance remains planning-owned (camera-to-planning.md 7.1).
       This launch enables jamming control below; it is not a read-only monitor. -->
  <arg name="expected_config_sha256"
       default="2d17cf63adbf2ba049d70656233ee2f34e9a4bfb43373ee76b3371aab1e4dc2a"/>
  <arg name="calibration_file" default="$(find asmc_camera)/config/cameras_v3.yaml"/>
  <arg name="rviz" default="false" doc="재밍 카메라 차선변경 RViz(BBOX·차선·경로) 표시"/>
  <!-- 재밍 회피 튜닝(jamming_dev.launch와 같은 값). 좁은 틈 통과와 바깥쪽 회피선을 위해
       여유는 줄이고 바깥 한계·추가 밀기는 늘렸다. 필요 여유 = 차폭/2 + max(clearance, margin). -->
  <arg name="jamming_line_edge_expand" default="0.30" doc="[m] 기준선 1·5를 바깥으로 확장(최대 0.5)"/>
  <arg name="jamming_avoid_line_extra" default="1.0" doc="통과 가능한 선에서 바깥으로 더 미는 양(선 번호, 최대 2.0)"/>
  <arg name="jamming_avoid_clearance" default="0.05" doc="[m] 차체 측면-장애물 최소 간격"/>
  <arg name="jamming_obstacle_lateral_margin" default="0.05" doc="[m] 차체 좌우 여유(도로 경계 검사 포함)"/>
  <arg name="jamming_avoid_line_overrun" default="1.5" doc="[m] 벽 미확인 쪽에서 차량 중심이 끝 차선을 넘을 수 있는 거리"/>
  <!-- 재밍 회피에 LiDAR 물체(카메라가 못 잡은 장애물)와 벽(갓길 한계)을 함께 쓴다.
       asmc_lidar를 skip_lidar_in_jamming:=false(기본)로 띄워야 재밍 중에도 들어온다. -->
  <arg name="jamming_use_lidar_obstacles" default="true"/>
  <!-- 차선 끊김·지날 선 없음 등 인식/판단 정지 대신 이 속도로 기어간다. 사람 정지·비상정지·입력 timeout은
       정지를 유지한다. jamming_creep_clear_distance=0이면 LiDAR·카메라 장애물이 앞에 있어도 멈추지 않는다. -->
  <arg name="jamming_creep_speed_kph" default="3.0"/>
  <arg name="jamming_creep_clear_distance" default="0.0" doc="[m] 0보다 크면 앞 범퍼부터 이 거리 안 경로 장애물에 정지"/>

  <!-- One route/health/ownership policy for all three strategies. -->
  <rosparam ns="planning_mode" command="load" file="$(find asmc_planner)/config/jamming_transition.yaml"/>
  <group ns="planning_mode">
    <param name="strategy" value="$(arg jamming_planner)"/>
    <param name="links_file" value="$(find asmc_planner)/config/behavior/link_set.json"/>
    <param name="jamming_controller" value="$(eval {'camera':'/camera_bbox_lane_change','local':'/local_controller','localization':'/localization_controller'}[arg('jamming_planner')])"/>
    <param name="recovery_ready_topic" value="$(eval '/planning/localization/recovery_ready' if arg('jamming_planner') == 'localization' else '')"/>
    <param name="shadow_zone/path_file" value="$(find asmc_planner)/../../R_KR_PG_KATRI/2026_molit_comp_global_path.txt"/>
    <param name="shadow_zone/state_topic" value="$(arg state_topic)"/>
  </group>

  <!-- Dictionary lookup rejects unsupported sources during launch loading. -->
  <include if="$(eval {'competition': False, 'gps_imu': True, 'external': False}[arg('state_source')])"
           file="$(find planning_inputs)/launch/vehicle_state.launch">
    <arg name="state_topic" value="$(arg state_topic)"/>
  </include>
  <!-- The default MORAI run uses the measured competition longitudinal speed
       with the unchanged GPS/IMU map pose. The former GPS-only default could
       underestimate speed by about 25% in the first highway merge. -->
  <include if="$(eval {'competition': True, 'gps_imu': False, 'external': False}[arg('state_source')])"
           file="$(find planning_inputs)/launch/vehicle_state.launch">
    <arg name="state_topic" value="/planning/vehicle/gps_imu_state"/>
  </include>
  <node if="$(eval {'competition': True, 'gps_imu': False, 'external': False}[arg('state_source')])"
        pkg="asmc_planner" type="asmc_competition_speed_state_node"
        name="planning_competition_speed_state" output="screen" required="true">
    <rosparam command="load" file="$(find asmc_planner)/config/competition_speed_state.yaml"/>
    <param name="state_topic" value="$(arg state_topic)"/>
  </node>
  <include file="$(find planning_inputs)/launch/objects.launch">
    <arg name="input_topic" value="$(arg lidar_input_topic)"/>
    <arg name="output_topic" value="$(arg canonical_objects_topic)"/>
  </include>

  <include file="$(find asmc_planner)/launch/planner_v2.launch">
    <arg name="highway_merge" value="$(arg highway_merge)"/>
    <arg name="state_topic" value="$(arg state_topic)"/>
    <arg name="objects_input_type" value="detected"/>
    <arg name="behavior_objects_topic" value="$(arg canonical_objects_topic)"/>
    <arg name="planning_objects_topic" value="$(arg canonical_objects_topic)"/>
    <arg name="avoid_path_margin_m" value="$(arg avoid_path_margin_m)"/>
    <arg name="static_obstacle_unknown" value="$(arg static_obstacle_unknown)"/>
  </include>
  <include file="$(find asmc_controller)/launch/controller.launch">
    <arg name="state_topic" value="$(arg state_topic)"/>
    <arg name="suspend_in_jamming" value="true"/>
    <arg name="smooth_handoff" value="true"/>
    <arg name="initial_ready_topic" value="$(eval ('/planning/localization/control_ready' if arg('localization_local_recovery') else '/planning/localization/anchor_ready') if arg('jamming_planner') == 'localization' else '')"/>
  </include>
  <node pkg="asmc_planner" type="asmc_control_selector_node"
        name="asmc_control_selector" output="screen" required="true">
    <param name="smooth_handoff" value="true"/>
    <param name="initial_ready_topic" value="$(eval ('/planning/localization/control_ready' if arg('localization_local_recovery') else '/planning/localization/anchor_ready') if arg('jamming_planner') == 'localization' else '')"/>
    <param name="jamming_controller" value="$(eval {'camera':'/camera_bbox_lane_change','local':'/local_controller','localization':'/localization_controller'}[arg('jamming_planner')])"/>
    <param name="jamming_frame_prefix" value="$(eval 'base_link' if arg('jamming_planner') == 'camera' else 'local/')"/>
  </node>
  <!-- 재밍 BBOX 입력은 camera_bbox_frame_bridge가 /perception/camera/objects를 직접 받는다
       (별도 YOLO 변환 어댑터 없음, 소비 cutoff는 bbox_conf_thres 0.7). -->
  <include if="$(eval arg('jamming_planner') == 'camera')" file="$(find lane_boundary_adapter)/launch/camera_bbox_lane_change.launch">
    <arg name="enable_control" value="true"/>
    <arg name="smooth_handoff" value="true"/>
    <!-- PR127 recovery is intentional; PR128 highway/dashboard ownership above stays unchanged. -->
    <arg name="return_to_entry_lane" value="true"/>
    <arg name="control_topic" value="/ctrl_cmd/jamming"/>
    <arg name="expected_config_sha256" value="$(arg expected_config_sha256)"/>
    <arg name="calibration_file" value="$(arg calibration_file)"/>
    <arg name="use_rviz" value="$(arg rviz)"/>
    <!-- jamming_dev.launch에서 실주행 통과를 확인한 재밍 튜닝값. 두 곳을 함께 바꾼다. -->
    <arg name="straddle_avoidance" value="true"/>
    <arg name="line_edge_expand" value="$(arg jamming_line_edge_expand)"/>
    <arg name="avoid_line_extra" value="$(arg jamming_avoid_line_extra)"/>
    <arg name="avoid_clearance" value="$(arg jamming_avoid_clearance)"/>
    <arg name="obstacle_lateral_margin" value="$(arg jamming_obstacle_lateral_margin)"/>
    <arg name="avoid_line_overrun" value="$(arg jamming_avoid_line_overrun)"/>
    <arg name="avoid_max_shoulder" value="2.0"/>
    <arg name="use_lidar_obstacles" value="$(arg jamming_use_lidar_obstacles)"/>
    <arg name="creep_speed_kph" value="$(arg jamming_creep_speed_kph)"/>
    <arg name="creep_clear_distance" value="$(arg jamming_creep_clear_distance)"/>
    <arg name="target_speed_kph" value="$(arg jamming_speed_kph)"/>
    <arg name="avoid_speed_kph" value="$(eval min(10.,float(arg('jamming_speed_kph'))))"/>
    <arg name="avoid_shift_length" value="7.0"/>
    <arg name="max_lateral_accel" value="1.8"/>
    <arg name="max_steering_rate" value="1.0"/>
    <arg name="stop_brake" value="0.5"/>
    <arg name="speed_kp" value="0.3"/>
    <arg name="speed_ki" value="0.1"/>
    <arg name="max_accel_pedal" value="0.5"/>
    <arg name="max_brake_pedal" value="0.5"/>
  </include>
  <include if="$(eval arg('jamming_planner') == 'local')" file="$(find asmc_planner)/launch/local.launch">
    <arg name="enable_control" value="true"/>
    <arg name="smooth_handoff" value="true"/>
    <arg name="active_in_jamming_only" value="true"/>
    <arg name="normal_controller_node" value="/mpc_controller"/>
    <arg name="selector_node" value="/asmc_control_selector"/>
    <arg name="semantic_input" value="$(arg local_semantic_input)"/>
    <arg name="speed_cap_kph" value="$(arg jamming_speed_kph)"/>
    <arg name="run_id" value="$(arg shadow_run_id)"/>
    <arg name="journal_path" value="$(arg shadow_journal_path)"/>
    <arg name="planner_config" value="$(arg local_planner_config)"/>
    <arg name="forward_warning_weight" value="$(arg local_forward_warning_weight)"/>
  </include>
  <!-- Recovery planner has no controller and cannot publish control proposals. -->
  <include if="$(eval arg('jamming_planner') == 'localization' and arg('localization_local_recovery'))" file="$(find asmc_planner)/launch/local.launch">
    <arg name="start_controller" value="false"/>
    <arg name="enable_control" value="false"/>
    <arg name="active_in_jamming_only" value="true"/>
    <arg name="semantic_input" value="$(arg local_semantic_input)"/>
    <arg name="speed_cap_kph" value="5"/>
    <arg name="run_id" value="$(arg shadow_run_id)"/>
    <arg name="planner_config" value="$(arg local_planner_config)"/>
    <arg name="forward_warning_weight" value="$(arg local_forward_warning_weight)"/>
  </include>
  <include if="$(eval arg('jamming_planner') == 'localization')" file="$(find asmc_planner)/launch/shadow_localization.launch">
    <arg name="local_recovery" value="$(arg localization_local_recovery)"/>
    <arg name="run_id" value="$(arg shadow_run_id)"/>
    <arg name="speed_cap_kph" value="$(arg shadow_speed_cap_kph)"/>
    <arg name="journal_path" value="$(arg shadow_journal_path)"/>
    <arg name="enable_control" value="true"/>
    <arg name="mode_gated" value="true"/>
    <arg name="static_avoidance" value="$(arg shadow_static_avoidance)"/>
    <arg name="dynamic_obstacles" value="$(arg shadow_dynamic_obstacles)"/>
    <arg name="shadow_lane_rules" value="$(arg shadow_lane_rules)"/>
    <arg name="smooth_handoff" value="true"/>
    <arg name="integrated_normal_controller" value="/mpc_controller"/>
    <arg name="start_motion" value="$(arg shadow_start_motion)"/>
    <arg name="motion_yaw_source" value="$(arg shadow_motion_yaw_source)"/>
    <arg name="motion_reference_offset_m" value="$(arg shadow_motion_reference_offset_m)"/>
    <arg name="motion_turn_gain_m2ps" value="$(arg shadow_motion_turn_gain_m2ps)"/>
    <arg name="state_topic" value="$(arg shadow_motion_topic)"/>
  </include>
  <include if="$(arg dashboard)" file="$(find asmc_planner)/launch/dashboard.launch">
    <arg name="state_topic" value="$(arg state_topic)"/>
    <arg name="dashboard_port" value="$(arg dashboard_port)"/>
    <arg name="open_dashboard" value="$(arg open_dashboard)"/>
    <arg name="dashboard_lidar_objects_topic" value="$(arg canonical_objects_topic)"/>
  </include>
</launch>
