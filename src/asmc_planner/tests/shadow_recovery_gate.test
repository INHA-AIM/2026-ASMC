<launch>
  <group ns="planning_mode">
    <param name="exit_hold_s" value="0.0"/>
    <param name="gps_timeout_s" value="0.0"/>
    <param name="recovery_timeout_s" value="0.3"/>
    <param name="recovery_ready_topic" value="/planning/localization/recovery_ready"/>
  </group>
  <node pkg="asmc_planner" type="gps_mode_source_test_node" name="gps_mode_source_test_node" required="true"/>
  <test pkg="asmc_planner" type="shadow_recovery_gate_test.py" test-name="shadow_recovery_gate" time-limit="20"/>
</launch>
