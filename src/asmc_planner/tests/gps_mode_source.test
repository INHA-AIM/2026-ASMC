<launch>
  <!-- 핸드오프 시험은 판정 지연 없이 복귀 대기만 본다. 판정 규칙은 mode_detector_test가 맡는다. -->
  <group ns="planning_mode">
    <param name="exit_hold_s" value="0.0"/>
    <param name="gps_timeout_s" value="0.0"/>
  </group>
  <node pkg="asmc_planner" type="gps_mode_source_test_node"
        name="gps_mode_source_test_node" required="true"/>
  <test pkg="asmc_planner" type="gps_mode_source_test.py"
        test-name="gps_mode_source_test" time-limit="30"/>
</launch>
