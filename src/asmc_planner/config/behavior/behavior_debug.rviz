Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Selection
    Name: Selection
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 10
      Class: rviz/Grid
      Color: 80; 90; 100
      Enabled: true
      Name: Grid
      Plane: XY
      Reference Frame: map
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /behavior/markers
      Name: Behavior markers
      Queue Size: 10
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /planning/markers
      Name: Frenet candidates and selected trajectory
      Queue Size: 10
  Enabled: true
  Global Options:
    Background Color: 7; 16; 24
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
  Views:
    Current:
      Class: rviz/TopDownOrtho
      Name: Top Down
      Scale: 80
Window Geometry:
  Height: 900
  Width: 1500
