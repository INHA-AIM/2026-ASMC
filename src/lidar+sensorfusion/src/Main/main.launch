<launch>
  <!-- MORAI sends VLP-16 packets (Velodyne product ID 0x22). -->
  <arg name="lidar_port" default="9299"/>
  <!-- Keep this false when 2026-ASMC/morai_sensor_bridge publishes
       /velodyne_points. Set true only for direct raw Velodyne UDP input. -->
  <arg name="start_velodyne_driver" default="false"/>
  <arg name="rviz" default="false"/>
  <arg name="enable_sensor_fusion" default="true"/>
  <!-- YOLO 추론 장치. 기본은 CUDA 강제이며, CPU 실행은 명시적 선택이어야 한다. -->
  <arg name="yolo_require_cuda" default="true"/>
  <arg name="yolo_device" default="cuda:0"/>
  <arg name="yolo_perf_log_interval_sec" default="5.0"/>
  <!-- Association remains strict at 50 ms, but waits up to 200 ms for a
       delayed YOLO result before declaring that a LiDAR frame has no match. -->
  <arg name="fusion_max_time_offset_sec" default="0.05"/>
  <arg name="fusion_sync_wait_timeout_sec" default="0.20"/>
  <arg name="roi_min_x" default="-30.0"/>
  <arg name="roi_max_x" default="50.0"/>
  <arg name="roi_min_y" default="-20.0"/>
  <arg name="roi_max_y" default="20.0"/>
  <!-- ROI 폭별 전처리 비용 측정용. 평시에는 꺼져 있고, 켜면 표본을 다 모은
       뒤 집계 로그를 남기고 노드가 스스로 종료한다. -->
  <arg name="benchmark_lidar_pipeline" default="false"/>
  <arg name="benchmark_warmup_frames" default="30"/>
  <arg name="benchmark_sample_frames" default="200"/>
  <!-- Split scans on the azimuth wrap because MORAI's packet timing does not
       match the physical VLP-16 packet-rate/RPM calculation. -->
  <arg name="lidar_cut_angle" default="0.0"/>
  <include if="$(arg start_velodyne_driver)"
           file="$(find velodyne_pointcloud)/launch/VLP16_points.launch">
    <arg name="port" value="$(arg lidar_port)"/>
    <arg name="cut_angle" value="$(arg lidar_cut_angle)"/>
  </include>

  <!-- 인지 메인 노드: 카메라 UDP 수신, GPS/IMU/CAN 파싱, 라이다 전처리, 센서퓨전 -->
  <node name="Main" pkg="Main" type="main" output="screen">
    <!-- Main's legacy parser asks for /Competition_topic. The 2026-ASMC
         vehicle bridge publishes the same EgoVehicleStatus on /Ego_topic. -->
    <remap from="/Competition_topic" to="/Ego_topic"/>
    <param name="enable_sensor_fusion" value="$(arg enable_sensor_fusion)"/>
    <param name="roi_min_x" value="$(arg roi_min_x)"/>
    <param name="roi_max_x" value="$(arg roi_max_x)"/>
    <param name="roi_min_y" value="$(arg roi_min_y)"/>
    <param name="roi_max_y" value="$(arg roi_max_y)"/>
    <param name="benchmark_lidar_pipeline"
           value="$(arg benchmark_lidar_pipeline)"/>
    <param name="benchmark_warmup_frames"
           value="$(arg benchmark_warmup_frames)"/>
    <param name="benchmark_sample_frames"
           value="$(arg benchmark_sample_frames)"/>
    <!-- Threat-oriented LiDAR-only motion classifier. Tracker velocity remains
         the unfiltered, current-frame value; these parameters affect only
         is_dynamic and its diagnostics. -->
    <param name="motion_history_size" value="5"/>
    <param name="motion_warmup_observations" value="3"/>
    <param name="motion_low_threat_confirmations" value="3"/>
    <param name="motion_dynamic_confirmations" value="2"/>
    <param name="motion_change_confirmations" value="3"/>
    <param name="motion_short_miss_limit" value="3"/>
    <param name="motion_lateral_threshold_kph" value="3.0"/>
    <param name="motion_longitudinal_threshold_kph" value="10.0"/>
    <param name="motion_fast_lateral_threshold_kph" value="5.0"/>
    <param name="motion_velocity_jump_kph" value="10.0"/>
    <param name="motion_direction_cosine_min" value="0.7"/>
    <param name="motion_longitudinal_displacement_kph" value="5.0"/>
    <param name="drivable_mask_image"
           value="$(find Main)/../../../link_node/out/road_mask.png"/>
    <param name="drivable_mask_metadata"
           value="$(find Main)/../../../link_node/out/road_mask.yaml"/>
    <param name="drivable_map_id" value="waize_katri_2025-10-23"/>
    <param name="drivable_margin_m" value="1.0"/>
    <param name="drivable_ratio_threshold" value="0.3"/>
    <param name="drivable_samples" value="5"/>
    <!-- Sensor poses and camera intrinsics come from setting.yaml. The C++
         node still accepts private ROS-parameter overrides for fine tuning. -->
    <param name="fusion_iou_threshold" value="0.25"/>
    <param name="fusion_max_time_offset_sec"
           value="$(arg fusion_max_time_offset_sec)"/>
    <param name="fusion_sync_wait_timeout_sec"
           value="$(arg fusion_sync_wait_timeout_sec)"/>
    <param name="fusion_initial_confirmations" value="5"/>
    <param name="fusion_change_confirmations" value="3"/>
    <param name="fusion_class_miss_grace" value="3"/>
    <!-- Disabled by default: a valid nearby object may legitimately reach the
         bottom of the image. The targeted YOLO ego-hood filter remains on. -->
    <param name="fusion_exclude_hood_y_band" value="false"/>
  </node>

  <!-- YOLO 검출: /camera/image/compressed 구독 -> /YOLO/BBox 발행.
       type이 yolo_detection_node(shell 래퍼)인 이유는, catkin이 생성하는
       YOLODetection.py relay가 시스템 Python 3.8로 shebang이 고정되기
       때문이다. 래퍼가 /opt/yolo-venv/bin/python(CUDA 12.8 PyTorch)을
       명시적으로 실행한다. -->
  <node if="$(arg enable_sensor_fusion)" name="yolo_detection_node" pkg="Main" type="yolo_detection_node" output="screen">
    <param name="weights" value="$(find Main)/YOLOWeight/yolo11m.pt"/>
    <!-- CUDA를 쓸 수 없으면 조용히 CPU로 내려가지 않고 노드를 종료한다.
         의도적으로 CPU에서 돌리려면 require_cuda를 false로 바꿔야 한다. -->
    <param name="require_cuda" value="$(arg yolo_require_cuda)"/>
    <param name="device" value="$(arg yolo_device)"/>
    <param name="perf_log_interval_sec" value="$(arg yolo_perf_log_interval_sec)"/>
  </node>

  <node if="$(arg rviz)" name="sensor_fusion_rviz" pkg="rviz" type="rviz"
        args="-f map" output="screen"/>
</launch>
