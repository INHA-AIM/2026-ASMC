<launch>
  <!-- MORAI sends VLP-16 packets (Velodyne product ID 0x22). -->
  <arg name="lidar_port" default="9299"/>
  <!-- Keep this false when 2026-ASMC/asmc_bridge sensor node publishes
       /velodyne_points. Set true only for direct raw Velodyne UDP input. -->
  <arg name="start_velodyne_driver" default="false"/>
  <arg name="rviz" default="false"/>
  <arg name="enable_sensor_fusion" default="true"/>
  <!-- YOLO 추론 장치. 기본은 CUDA 강제이며, CPU 실행은 명시적 선택이어야 한다. -->
  <arg name="yolo_require_cuda" default="true"/>
  <arg name="yolo_device" default="cuda:0"/>
  <arg name="yolo_perf_log_interval_sec" default="5.0"/>
  <!-- Association remains strict at 50 ms, but waits up to 200 ms for a
       delayed YOLO result before declaring that a LiDAR frame has no match. -->
  <arg name="fusion_max_time_offset_sec" default="0.05"/>
  <arg name="fusion_sync_wait_timeout_sec" default="0.20"/>
  <arg name="roi_min_x" default="-30.0"/>
  <arg name="roi_max_x" default="50.0"/>
  <arg name="roi_min_y" default="-20.0"/>
  <arg name="roi_max_y" default="20.0"/>
  <!-- ROI 폭별 전처리 비용 측정용. 평시에는 꺼져 있고, 켜면 표본을 다 모은
       뒤 집계 로그를 남기고 노드가 스스로 종료한다. -->
  <arg name="benchmark_lidar_pipeline" default="false"/>
  <arg name="benchmark_warmup_frames" default="30"/>
  <arg name="benchmark_sample_frames" default="200"/>
  <!-- GPS 음영(터널) 전용 LiDAR 구조물 제거 실험 파이프라인. 기본 OFF.
       true여도 GPS가 정상인 프레임에서는 실행되지 않고, 결과는
       /lidar/tunnel/* 전용 토픽으로만 나간다 (/last_lidar, /lidar_nogps 불변). -->
  <arg name="enable_tunnel_experimental_filter" default="false"/>
  <arg name="tunnel_dynamic_roi_enable" default="true"/>
  <arg name="tunnel_roi_min_x_m" default="-30.0"/>
  <arg name="tunnel_roi_max_x_m" default="40.0"/>
  <arg name="tunnel_roi_min_y_m" default="-10.0"/>
  <arg name="tunnel_roi_max_y_m" default="10.0"/>
  <arg name="tunnel_roi_min_z_m" default="-2.0"/>
  <arg name="tunnel_roi_max_z_m" default="3.0"/>
  <arg name="tunnel_ceiling_max_z_lidar_m" default="2.55"/>
  <arg name="tunnel_expected_ground_z_lidar_m" default="-1.45"/>
  <arg name="tunnel_ground_candidate_z_min_m" default="-1.90"/>
  <arg name="tunnel_ground_candidate_z_max_m" default="-1.00"/>
  <arg name="tunnel_ground_ransac_max_iterations" default="100"/>
  <arg name="tunnel_ground_ransac_distance_threshold_m" default="0.18"/>
  <arg name="tunnel_ground_normal_max_angle_deg" default="15.0"/>
  <arg name="tunnel_wall_search_min_abs_y_m" default="1.75"/>
  <arg name="tunnel_wall_remove_distance_m" default="0.25"/>
  <arg name="tunnel_cluster_tolerance_m" default="1.0"/>
  <arg name="tunnel_protect_enable" default="true"/>
  <!-- Split scans on the azimuth wrap because MORAI's packet timing does not
       match the physical VLP-16 packet-rate/RPM calculation. -->
  <arg name="lidar_cut_angle" default="0.0"/>
  <include if="$(arg start_velodyne_driver)"
           file="$(find velodyne_pointcloud)/launch/VLP16_points.launch">
    <arg name="port" value="$(arg lidar_port)"/>
    <arg name="cut_angle" value="$(arg lidar_cut_angle)"/>
  </include>

  <!-- 인지 메인 노드: 카메라 UDP 수신, GPS/IMU/CAN 파싱, 라이다 전처리, 센서퓨전 -->
  <node name="Main" pkg="Main" type="main" output="screen">
    <!-- Main's legacy parser asks for /Competition_topic. The 2026-ASMC
         vehicle bridge publishes the same EgoVehicleStatus on /Ego_topic. -->
    <remap from="/Competition_topic" to="/Ego_topic"/>
    <param name="enable_sensor_fusion" value="$(arg enable_sensor_fusion)"/>
    <param name="roi_min_x" value="$(arg roi_min_x)"/>
    <param name="roi_max_x" value="$(arg roi_max_x)"/>
    <param name="roi_min_y" value="$(arg roi_min_y)"/>
    <param name="roi_max_y" value="$(arg roi_max_y)"/>
    <param name="benchmark_lidar_pipeline"
           value="$(arg benchmark_lidar_pipeline)"/>
    <param name="benchmark_warmup_frames"
           value="$(arg benchmark_warmup_frames)"/>
    <param name="benchmark_sample_frames"
           value="$(arg benchmark_sample_frames)"/>
    <!-- Threat-oriented LiDAR-only motion classifier. Tracker velocity remains
         the unfiltered, current-frame value; these parameters affect only
         is_dynamic and its diagnostics. -->
    <param name="motion_history_size" value="5"/>
    <param name="motion_warmup_observations" value="3"/>
    <param name="motion_low_threat_confirmations" value="3"/>
    <param name="motion_dynamic_confirmations" value="2"/>
    <param name="motion_change_confirmations" value="3"/>
    <param name="motion_short_miss_limit" value="3"/>
    <param name="motion_lateral_threshold_kph" value="3.0"/>
    <param name="motion_longitudinal_threshold_kph" value="10.0"/>
    <param name="motion_fast_lateral_threshold_kph" value="5.0"/>
    <param name="motion_velocity_jump_kph" value="10.0"/>
    <param name="motion_direction_cosine_min" value="0.7"/>
    <param name="motion_longitudinal_displacement_kph" value="5.0"/>
    <param name="drivable_mask_image"
           value="$(find asmc_hd_map)/development/won_tae_link_node/out/road_mask.png"/>
    <param name="drivable_mask_metadata"
           value="$(find asmc_hd_map)/development/won_tae_link_node/out/road_mask.yaml"/>
    <param name="drivable_map_id" value="waize_katri_2025-10-23"/>
    <param name="drivable_margin_m" value="1.0"/>
    <param name="drivable_ratio_threshold" value="0.3"/>
    <param name="drivable_samples" value="5"/>
    <!-- GPS 좌표가 0인 터널에서는 map 대신 velodyne-frame /lidar_nogps를
         발행하고, 융합으로 car/person이 확인되지 않은 구조물 OBB만 거른다. -->
    <param name="tunnel_ceiling_center_z_m" value="1.3"/>
    <param name="tunnel_wall_min_length_m" value="15.0"/>
    <param name="tunnel_wall_min_aspect_ratio" value="6.0"/>
    <param name="tunnel_wall_min_abs_y_m" value="4.0"/>
    <!-- ===== 터널 실험 필터 (/lidar/tunnel/*, 기본 OFF) =====
         위 /lidar_nogps OBB 필터와는 별개의 병렬 실험 경로다.
         순서: ROI+Voxel -> IMU roll/pitch 수평화 -> 천장 제거 -> 지면 RANSAC
         -> 지면 시간 안정화 -> 좌우 벽 평면 -> 클러스터링 -> OBB -> OBB 안전 필터. -->
    <param name="enable_tunnel_experimental_filter"
           value="$(arg enable_tunnel_experimental_filter)"/>
    <param name="tunnel_dynamic_roi_enable"
           value="$(arg tunnel_dynamic_roi_enable)"/>
    <param name="tunnel_roi_min_x_m" value="$(arg tunnel_roi_min_x_m)"/>
    <param name="tunnel_roi_max_x_m" value="$(arg tunnel_roi_max_x_m)"/>
    <param name="tunnel_roi_min_y_m" value="$(arg tunnel_roi_min_y_m)"/>
    <param name="tunnel_roi_max_y_m" value="$(arg tunnel_roi_max_y_m)"/>
    <param name="tunnel_roi_min_z_m" value="$(arg tunnel_roi_min_z_m)"/>
    <param name="tunnel_roi_max_z_m" value="$(arg tunnel_roi_max_z_m)"/>
    <param name="tunnel_level_roll" value="true"/>
    <param name="tunnel_level_pitch" value="true"/>
    <param name="tunnel_ceiling_max_z_lidar_m"
           value="$(arg tunnel_ceiling_max_z_lidar_m)"/>
    <param name="tunnel_expected_ground_z_lidar_m"
           value="$(arg tunnel_expected_ground_z_lidar_m)"/>
    <param name="tunnel_ground_candidate_z_min_m"
           value="$(arg tunnel_ground_candidate_z_min_m)"/>
    <param name="tunnel_ground_candidate_z_max_m"
           value="$(arg tunnel_ground_candidate_z_max_m)"/>
    <param name="tunnel_ground_candidate_max_range_m" value="40.0"/>
    <param name="tunnel_ground_prior_band_m" value="0.15"/>
    <param name="tunnel_ground_mode_bin_m" value="0.05"/>
    <param name="tunnel_ground_mode_max_range_m" value="20.0"/>
    <!-- 2단계 재적합: 1단계 평면 ±0.25 m에서 0.10 m로 다시 적합, 채택 조건 3°/0.05 m -->
    <param name="tunnel_ground_refit_enable" value="true"/>
    <param name="tunnel_ground_refit_band_m" value="0.25"/>
    <param name="tunnel_ground_refit_distance_m" value="0.10"/>
    <param name="tunnel_ground_refit_iterations" value="100"/>
    <param name="tunnel_ground_refit_max_angle_deg" value="3.0"/>
    <param name="tunnel_ground_refit_max_height_delta_m" value="0.05"/>
    <param name="tunnel_ground_ransac_max_iterations"
           value="$(arg tunnel_ground_ransac_max_iterations)"/>
    <param name="tunnel_ground_ransac_distance_threshold_m"
           value="$(arg tunnel_ground_ransac_distance_threshold_m)"/>
    <param name="tunnel_ground_normal_max_angle_deg"
           value="$(arg tunnel_ground_normal_max_angle_deg)"/>
    <param name="tunnel_ground_height_min_m" value="-1.90"/>
    <param name="tunnel_ground_height_max_m" value="-1.00"/>
    <param name="tunnel_ground_min_inliers" value="150"/>
    <param name="tunnel_ground_min_inlier_ratio" value="0.30"/>
    <param name="tunnel_ground_max_height_jump_m" value="0.15"/>
    <param name="tunnel_ground_max_normal_jump_deg" value="3.0"/>
    <param name="tunnel_ground_reuse_max_frames" value="3"/>
    <param name="tunnel_ground_remove_distance_m"
           value="$(arg tunnel_ground_ransac_distance_threshold_m)"/>
    <param name="tunnel_ground_remove_below_plane" value="true"/>
    <param name="tunnel_ground_fallback_band_m" value="0.20"/>
    <param name="tunnel_wall_enable" value="true"/>
    <param name="tunnel_wall_search_min_abs_y_m"
           value="$(arg tunnel_wall_search_min_abs_y_m)"/>
    <param name="tunnel_wall_search_x_min_m" value="-30.0"/>
    <param name="tunnel_wall_search_x_max_m" value="50.0"/>
    <param name="tunnel_wall_candidate_min_height_m" value="0.30"/>
    <param name="tunnel_wall_candidate_max_height_m" value="4.50"/>
    <param name="tunnel_wall_fit_distance_m" value="0.15"/>
    <param name="tunnel_wall_max_tilt_deg" value="5.0"/>
    <param name="tunnel_wall_step_max_angle_deg" value="5.0"/>
    <param name="tunnel_wall_step_max_offset_m" value="0.6"/>
    <param name="tunnel_wall_step_min_vertical_span_m" value="0.8"/>
    <param name="tunnel_wall_continuation_max_angle_deg" value="12.0"/>
    <param name="tunnel_wall_continuation_max_gap_m" value="6.0"/>
    <param name="tunnel_wall_continuation_min_span_m" value="6.0"/>
    <param name="tunnel_wall_continuation_min_bins" value="3"/>
    <param name="tunnel_wall_continuation_search_m" value="2.0"/>
    <param name="tunnel_wall_min_inliers" value="80"/>
    <param name="tunnel_wall_min_inlier_ratio" value="0.20"/>
    <param name="tunnel_wall_min_span_m" value="15.0"/>
    <param name="tunnel_wall_bin_size_m" value="2.0"/>
    <param name="tunnel_wall_bin_min_points" value="3"/>
    <param name="tunnel_wall_bin_max_gap" value="1"/>
    <param name="tunnel_wall_min_occupied_bins" value="6"/>
    <param name="tunnel_wall_min_vertical_span_m" value="2.0"/>
    <param name="tunnel_wall_max_beyond_fraction" value="0.25"/>
    <param name="tunnel_wall_max_segments" value="4"/>
    <param name="tunnel_wall_extend_min_run_m" value="4.0"/>
    <param name="tunnel_wall_extend_max_gap_m" value="12.0"/>
    <param name="tunnel_wall_min_persist_frames" value="3"/>
    <param name="tunnel_wall_track_max_angle_deg" value="6.0"/>
    <param name="tunnel_wall_track_max_offset_m" value="0.6"/>
    <param name="tunnel_wall_track_max_miss" value="2"/>
    <!-- 이전 벽 평면을 IMU yaw 변화·CAN 속도×dt로 현재 좌표계에 옮긴 뒤 비교 -->
    <param name="tunnel_wall_track_use_ego_motion" value="true"/>
    <param name="tunnel_wall_track_motion_max_dt_s" value="1.0"/>
    <param name="tunnel_wall_remove_distance_m"
           value="$(arg tunnel_wall_remove_distance_m)"/>
    <param name="tunnel_wall_remove_margin_m" value="1.0"/>
    <param name="tunnel_cluster_tolerance_m"
           value="$(arg tunnel_cluster_tolerance_m)"/>
    <param name="tunnel_cluster_min_points" value="10"/>
    <param name="tunnel_cluster_max_points" value="30000"/>
    <param name="tunnel_obb_filter_enable" value="true"/>
    <param name="tunnel_obb_ceiling_min_z_road_m" value="2.5"/>
    <param name="tunnel_obb_wall_min_abs_y_m" value="4.0"/>
    <param name="tunnel_obb_wall_min_length_m" value="15.0"/>
    <param name="tunnel_obb_wall_min_aspect_ratio" value="6.0"/>
    <param name="tunnel_obb_wall_attach_distance_m" value="0.8"/>
    <param name="tunnel_obb_wall_attach_max_angle_deg" value="10.0"/>
    <param name="tunnel_obb_wall_attached_min_length_m" value="8.0"/>
    <param name="tunnel_obb_remove_ground_residual" value="false"/>
    <param name="tunnel_protect_enable" value="$(arg tunnel_protect_enable)"/>
    <param name="tunnel_protect_max_dt_s"
           value="$(arg fusion_max_time_offset_sec)"/>
    <param name="tunnel_protect_depth_vehicle_m" value="6.0"/>
    <param name="tunnel_protect_depth_person_m" value="1.5"/>
    <param name="tunnel_protect_ambiguous_max_range_m" value="30.0"/>
    <!-- Sensor poses and camera intrinsics come from setting.yaml. The C++
         node still accepts private ROS-parameter overrides for fine tuning. -->
    <param name="fusion_iou_threshold" value="0.25"/>
    <param name="fusion_max_time_offset_sec"
           value="$(arg fusion_max_time_offset_sec)"/>
    <param name="fusion_sync_wait_timeout_sec"
           value="$(arg fusion_sync_wait_timeout_sec)"/>
    <param name="fusion_initial_confirmations" value="5"/>
    <param name="fusion_change_confirmations" value="3"/>
    <param name="fusion_class_miss_grace" value="3"/>
    <!-- Disabled by default: a valid nearby object may legitimately reach the
         bottom of the image. The targeted YOLO ego-hood filter remains on. -->
    <param name="fusion_exclude_hood_y_band" value="false"/>
  </node>

  <!-- YOLO 검출: /camera/image/compressed 구독 -> /YOLO/BBox 발행.
       type이 yolo_detection_node(shell 래퍼)인 이유는, catkin이 생성하는
       YOLODetection.py relay가 시스템 Python 3.8로 shebang이 고정되기
       때문이다. 래퍼가 /opt/yolo-venv/bin/python(CUDA 12.8 PyTorch)을
       명시적으로 실행한다. -->
  <node if="$(arg enable_sensor_fusion)" name="yolo_detection_node" pkg="Main" type="yolo_detection_node" output="screen">
    <param name="weights" value="$(find Main)/YOLOWeight/yolo11m.pt"/>
    <!-- CUDA를 쓸 수 없으면 조용히 CPU로 내려가지 않고 노드를 종료한다.
         의도적으로 CPU에서 돌리려면 require_cuda를 false로 바꿔야 한다. -->
    <param name="require_cuda" value="$(arg yolo_require_cuda)"/>
    <param name="device" value="$(arg yolo_device)"/>
    <param name="perf_log_interval_sec" value="$(arg yolo_perf_log_interval_sec)"/>
  </node>

  <node if="$(arg rviz)" name="sensor_fusion_rviz" pkg="rviz" type="rviz"
        args="-f map" output="screen"/>
</launch>
