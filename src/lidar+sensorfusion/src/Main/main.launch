<launch>
  <arg name="camera_class_profile" default="mission16_v1"/>
  <!-- Opt-in common geometry; roll promotion is a separate acceptance gate. -->
  <arg name="enable_common_geometry" default="false"/>
  <arg name="lidar_level_roll" default="false"/>
  <arg name="lidar_mount_config" default="$(find asmc_lidar)/config/autonav_v3.yaml"/>
  <arg name="fusion_camera_config" default="$(find asmc_camera)/config/cameras_v3.yaml"/>
  <arg name="map_altitude_origin_m" default="0.0"/>
  <arg name="fusion_yolo_policy" default="unique" doc="unique | bounded_reuse"/>
  <arg name="camera_objects_conf_thres" default="0.0" doc="Optional stricter adapter cutoff. Camera already filters confidence; 0 passes its accepted candidates without a hidden 0.7 gate."/>
  <!-- MORAI sends VLP-16 packets (Velodyne product ID 0x22). -->
  <arg name="lidar_port" default="9299"/>
  <!-- Keep this false when 2026-ASMC/asmc_bridge sensor node publishes
       /velodyne_points. Set true only for direct raw Velodyne UDP input. -->
  <arg name="start_velodyne_driver" default="false"/>
  <arg name="rviz" default="false"/>
  <arg name="enable_sensor_fusion" default="true"/>
  <!-- Association remains strict at 50 ms, but waits up to 200 ms for a
       delayed YOLO result before declaring that a LiDAR frame has no match. -->
  <arg name="fusion_max_time_offset_sec" default="0.05"/>
  <arg name="fusion_sync_wait_timeout_sec" default="0.20"/>
  <!-- Optional buffered JSONL observations; does not change fusion policy. -->
  <arg name="fusion_trace_path" default=""/>
  <arg name="roi_min_x" default="-30.0"/>
  <arg name="roi_max_x" default="50.0"/>
  <arg name="roi_min_y" default="-20.0"/>
  <arg name="roi_max_y" default="20.0"/>
  <arg name="motion_debug_topic" default="/lidar/motion_debug"/>
  <!-- Pedestrians remain fail-safe KEEP. Static objects use current road
       overlap; PENDING/DYNAMIC outside the mask survive only when their
       predicted OBB enters it. Static planner geometry is clipped to the
       actual road intersection. -->
  <arg name="drivable_filter_enabled" default="true"/>
  <arg name="drivable_margin_m" default="0.0"/>
  <arg name="drivable_ratio_threshold" default="0.15"/>
  <arg name="drivable_supersample" default="5"/>
  <!-- Planner 공용 입력에서 5 cm 지면 파편을 제거한다. UNKNOWN 객체는
       이 높이를 연속 3프레임 만족해야 /last_lidar에 실린다. 한번
       confirmed된 동일 track은 5연속 low-height frame에서만 해제한다. -->
  <arg name="planning_minimum_obstacle_height_m" default="0.10"/>
  <arg name="planning_confirmation_frames" default="3"/>
  <arg name="planning_release_frames" default="5"/>
  <!-- Clean-lap catalog is matched only after OBB tracking and camera fusion,
       immediately before /last_lidar publication. Limit it to the verified
       long guardrail beside the global path; everywhere else is fail-safe KEEP.
       Its long cluster center shifts by about 2 m as visible points change. -->
  <arg name="known_static_filter_enabled" default="true"/>
  <arg name="known_static_catalog"
       default="$(find Main)/known_static_objects.yaml"/>
  <arg name="known_static_center_tolerance_m" default="2.5"/>
  <arg name="known_static_application_region_enabled" default="true"/>
  <arg name="known_static_application_min_x" default="-35.0"/>
  <arg name="known_static_application_max_x" default="15.0"/>
  <arg name="known_static_application_min_y" default="108.0"/>
  <arg name="known_static_application_max_y" default="180.0"/>
  <!-- The same verified guardrail continues around the following long bend.
       Keep it as a disjoint region so the area between route sections is not
       implicitly enabled. -->
  <arg name="known_static_guardrail_extension_enabled" default="true"/>
  <arg name="known_static_guardrail_extension_min_x" default="-107.0"/>
  <arg name="known_static_guardrail_extension_max_x" default="15.0"/>
  <arg name="known_static_guardrail_extension_min_y" default="175.0"/>
  <arg name="known_static_guardrail_extension_max_y" default="345.0"/>
  <arg name="known_static_c052_structure_enabled" default="true"/>
  <arg name="known_static_c091_rail_enabled" default="true"/>
  <!-- Bag-verified, narrowly bounded static structures. This filter is
       fail-open and applies only to static UNKNOWN objects. -->
  <arg name="static_structure_exclusion_enabled" default="true"/>
  <arg name="static_structure_exclusion_config"
       default="$(find Main)/../../../planning_inputs/config/static_structure_exclusions.yaml"/>
  <arg name="static_structure_minimum_height_m" default="2.5"/>
  <arg name="static_structure_minimum_bottom_z_m" default="2.0"/>
  <!-- Ground segmentation is constrained to near-horizontal, low-height seed
       points. The far threshold is relaxed without erasing low obstacles near
       the ego vehicle. -->
  <arg name="ground_distance_threshold_near_m" default="0.30"/>
  <arg name="ground_distance_threshold_far_m" default="0.40"/>
  <arg name="ground_threshold_far_range_m" default="50.0"/>
  <arg name="ground_max_tilt_deg" default="25.0"/>
  <arg name="ground_seed_min_z_m" default="-2.0"/>
  <arg name="ground_seed_max_z_m" default="-0.65"/>
  <arg name="ground_ransac_maximum_iterations" default="80"/>
  <arg name="ground_minimum_seed_points" default="30"/>
  <arg name="ground_fallback_frames" default="2"/>
  <!-- Reject malformed (0,0), out-of-map and physically impossible GPS
       jumps before they can displace LiDAR objects in the map frame. -->
  <arg name="gps_sanity_maximum_speed_mps" default="80.0"/>
  <arg name="gps_sanity_base_jump_allowance_m" default="3.0"/>
  <arg name="gps_sanity_reanchor_after_s" default="2.0"/>
  <!-- With common geometry, stale GPS suppresses map outputs while local
       processing continues. Legacy mode retains its original pose gate. -->
  <arg name="lidar_pose_gps_max_age_s" default="0.30"/>
  <!-- Match planning_inputs' MORAI true-ENU to UTM heading conversion. -->
  <arg name="imu_yaw_is_true_enu" default="true"/>
  <arg name="lidar_pose_imu_max_age_s" default="0.12"/>
  <arg name="lidar_pose_can_max_age_s" default="0.12"/>
  <!-- Only absorbs callback-order jitter; source stamps and stale limits stay authoritative. -->
  <arg name="lidar_pose_wait_timeout_s" default="0.05"/>
  <arg name="lidar_pose_maximum_speed_mps" default="35.0"/>
  <!-- ROI 폭별 전처리 비용 측정용. 평시에는 꺼져 있고, 켜면 표본을 다 모은
       뒤 집계 로그를 남기고 노드가 스스로 종료한다. -->
  <arg name="benchmark_lidar_pipeline" default="false"/>
  <arg name="benchmark_warmup_frames" default="30"/>
  <arg name="benchmark_sample_frames" default="200"/>
  <!-- Split scans on the azimuth wrap because MORAI's packet timing does not
       match the physical VLP-16 packet-rate/RPM calculation. -->
  <arg name="lidar_cut_angle" default="0.0"/>
  <include if="$(arg start_velodyne_driver)"
           file="$(find velodyne_pointcloud)/launch/VLP16_points.launch">
    <arg name="port" value="$(arg lidar_port)"/>
    <arg name="cut_angle" value="$(arg lidar_cut_angle)"/>
  </include>

  <!-- 인지 메인 노드: 카메라 UDP 수신, GPS/IMU/CAN 파싱, 라이다 전처리, 센서퓨전 -->
  <node name="Main" pkg="Main" type="main" output="screen">
    <param name="imu_yaw_is_true_enu" value="$(arg imu_yaw_is_true_enu)"/>
    <param name="enable_common_geometry" value="$(arg enable_common_geometry)"/>
    <param name="lidar_level_roll" value="$(arg lidar_level_roll)"/>
    <param name="lidar_mount_config" value="$(arg lidar_mount_config)"/>
    <param name="camera_class_profile" value="$(arg camera_class_profile)"/>
    <param name="fusion_camera_config" value="$(arg fusion_camera_config)"/>
    <param name="map_altitude_origin_m" value="$(arg map_altitude_origin_m)"/>
    <!-- Main's legacy parser asks for /Competition_topic. The 2026-ASMC
         vehicle bridge publishes the same EgoVehicleStatus on /Ego_topic. -->
    <remap from="/Competition_topic" to="/Ego_topic"/>
    <param name="enable_sensor_fusion" value="$(arg enable_sensor_fusion)"/>
    <param name="fusion_trace_path" value="$(arg fusion_trace_path)"/>
    <param name="roi_min_x" value="$(arg roi_min_x)"/>
    <param name="roi_max_x" value="$(arg roi_max_x)"/>
    <param name="roi_min_y" value="$(arg roi_min_y)"/>
    <param name="roi_max_y" value="$(arg roi_max_y)"/>
    <param name="benchmark_lidar_pipeline"
           value="$(arg benchmark_lidar_pipeline)"/>
    <param name="benchmark_warmup_frames"
           value="$(arg benchmark_warmup_frames)"/>
    <param name="benchmark_sample_frames"
           value="$(arg benchmark_sample_frames)"/>
    <!-- Threat-oriented LiDAR-only motion classifier. Tracker velocity remains
         the unfiltered current-frame value; the planner receives the separate
         state-gated/provisional velocity produced by this classifier. -->
    <param name="motion_history_size" value="5"/>
    <param name="motion_warmup_observations" value="3"/>
    <param name="motion_low_threat_confirmations" value="3"/>
    <param name="motion_dynamic_confirmations" value="3"/>
    <param name="motion_pending_static_confirmations" value="3"/>
    <param name="motion_dynamic_release_confirmations" value="8"/>
    <param name="motion_pending_max_frames" value="5"/>
    <param name="motion_change_confirmations" value="3"/>
    <param name="motion_short_miss_limit" value="3"/>
    <param name="motion_lateral_threshold_kph" value="4.0"/>
    <param name="motion_longitudinal_threshold_kph" value="10.0"/>
    <param name="motion_fast_lateral_threshold_kph" value="12.0"/>
    <param name="motion_velocity_jump_kph" value="10.0"/>
    <param name="motion_direction_cosine_min" value="0.7"/>
    <param name="motion_longitudinal_displacement_kph" value="8.0"/>
    <param name="motion_lateral_displacement_kph" value="3.0"/>
    <param name="motion_exit_speed_kph" value="2.5"/>
    <param name="motion_edge_agreement_tolerance_m" value="0.35"/>
    <param name="motion_debug_topic" value="$(arg motion_debug_topic)"/>
    <param name="drivable_filter_enabled"
           value="$(arg drivable_filter_enabled)"/>
    <param name="known_static_filter_enabled"
           value="$(arg known_static_filter_enabled)"/>
    <param name="known_static_catalog" value="$(arg known_static_catalog)"/>
    <param name="known_static_center_tolerance_m"
           value="$(arg known_static_center_tolerance_m)"/>
    <param name="known_static_application_region_enabled"
           value="$(arg known_static_application_region_enabled)"/>
    <param name="known_static_c052_structure_enabled"
           value="$(arg known_static_c052_structure_enabled)"/>
    <param name="known_static_c091_rail_enabled"
           value="$(arg known_static_c091_rail_enabled)"/>
    <param name="known_static_application_min_x"
           value="$(arg known_static_application_min_x)"/>
    <param name="known_static_application_max_x"
           value="$(arg known_static_application_max_x)"/>
    <param name="known_static_application_min_y"
           value="$(arg known_static_application_min_y)"/>
    <param name="known_static_application_max_y"
           value="$(arg known_static_application_max_y)"/>
    <param name="known_static_guardrail_extension_enabled"
           value="$(arg known_static_guardrail_extension_enabled)"/>
    <param name="known_static_guardrail_extension_min_x"
           value="$(arg known_static_guardrail_extension_min_x)"/>
    <param name="known_static_guardrail_extension_max_x"
           value="$(arg known_static_guardrail_extension_max_x)"/>
    <param name="known_static_guardrail_extension_min_y"
           value="$(arg known_static_guardrail_extension_min_y)"/>
    <param name="known_static_guardrail_extension_max_y"
           value="$(arg known_static_guardrail_extension_max_y)"/>
    <param name="static_structure_exclusion_enabled"
           value="$(arg static_structure_exclusion_enabled)"/>
    <param name="static_structure_exclusion_config"
           value="$(arg static_structure_exclusion_config)"/>
    <param name="static_structure_minimum_height_m"
           value="$(arg static_structure_minimum_height_m)"/>
    <param name="static_structure_minimum_bottom_z_m"
           value="$(arg static_structure_minimum_bottom_z_m)"/>
    <param name="ground_distance_threshold_near_m"
           value="$(arg ground_distance_threshold_near_m)"/>
    <param name="ground_distance_threshold_far_m"
           value="$(arg ground_distance_threshold_far_m)"/>
    <param name="ground_threshold_far_range_m"
           value="$(arg ground_threshold_far_range_m)"/>
    <param name="ground_max_tilt_deg" value="$(arg ground_max_tilt_deg)"/>
    <param name="ground_seed_min_z_m" value="$(arg ground_seed_min_z_m)"/>
    <param name="ground_seed_max_z_m" value="$(arg ground_seed_max_z_m)"/>
    <param name="ground_ransac_maximum_iterations"
           value="$(arg ground_ransac_maximum_iterations)"/>
    <param name="ground_minimum_seed_points"
           value="$(arg ground_minimum_seed_points)"/>
    <param name="ground_fallback_frames" value="$(arg ground_fallback_frames)"/>
    <param name="gps_sanity_min_x" value="-454.5159"/>
    <param name="gps_sanity_min_y" value="-825.0458"/>
    <param name="gps_sanity_max_x" value="162.4841"/>
    <param name="gps_sanity_max_y" value="621.3542"/>
    <param name="gps_sanity_maximum_speed_mps"
           value="$(arg gps_sanity_maximum_speed_mps)"/>
    <param name="gps_sanity_base_jump_allowance_m"
           value="$(arg gps_sanity_base_jump_allowance_m)"/>
    <param name="gps_sanity_reanchor_after_s"
           value="$(arg gps_sanity_reanchor_after_s)"/>
    <param name="lidar_pose_gps_max_age_s"
           value="$(arg lidar_pose_gps_max_age_s)"/>
    <param name="lidar_pose_imu_max_age_s"
           value="$(arg lidar_pose_imu_max_age_s)"/>
    <param name="lidar_pose_can_max_age_s"
           value="$(arg lidar_pose_can_max_age_s)"/>
    <param name="lidar_pose_wait_timeout_s"
           value="$(arg lidar_pose_wait_timeout_s)"/>
    <param name="lidar_pose_maximum_speed_mps"
           value="$(arg lidar_pose_maximum_speed_mps)"/>
    <param name="drivable_mask_image"
           value="$(find Main)/../../../planning_inputs/config/validated_0781402/road_mask.png"/>
    <param name="drivable_mask_metadata"
           value="$(find Main)/../../../planning_inputs/config/validated_0781402/road_mask.yaml"/>
    <param name="drivable_map_id" value="waize_katri_2025-10-23"/>
    <param name="drivable_origin_easting" value="302595.0"/>
    <param name="drivable_origin_northing" value="4124145.0"/>
    <param name="drivable_origin_altitude" value="0.0"/>
    <param name="drivable_margin_m" value="$(arg drivable_margin_m)"/>
    <param name="drivable_ratio_threshold"
           value="$(arg drivable_ratio_threshold)"/>
    <param name="drivable_samples" value="$(arg drivable_supersample)"/>
    <param name="planning_minimum_obstacle_height_m"
           value="$(arg planning_minimum_obstacle_height_m)"/>
    <param name="planning_confirmation_frames"
           value="$(arg planning_confirmation_frames)"/>
    <param name="planning_release_frames"
           value="$(arg planning_release_frames)"/>
    <!-- Sensor poses and camera intrinsics come from setting.yaml. The C++
         node still accepts private ROS-parameter overrides for fine tuning. -->
    <param name="fusion_iou_threshold" value="0.25"/>
    <param name="fusion_yolo_policy" value="$(arg fusion_yolo_policy)"/>
    <param name="fusion_max_time_offset_sec"
           value="$(arg fusion_max_time_offset_sec)"/>
    <param name="fusion_sync_wait_timeout_sec"
           value="$(arg fusion_sync_wait_timeout_sec)"/>
    <param name="fusion_initial_confirmations" value="5"/>
    <param name="fusion_change_confirmations" value="3"/>
    <param name="fusion_class_miss_grace" value="3"/>
    <!-- Disabled by default: a valid nearby object may legitimately reach the
         bottom of the image. The targeted YOLO ego-hood filter remains on. -->
    <param name="fusion_exclude_hood_y_band" value="false"/>
  </node>

  <!-- Inference belongs to a separately launched asmc_camera/camera.launch.
       This CPU adapter consumes front results only; it never loads a model. -->
  <group if="$(arg enable_sensor_fusion)">
  <node name="camera_objects_yolo_bbox_adapter" pkg="Main"
        type="camera_objects_yolo_bbox_adapter.py" output="screen" required="false">
    <param name="conf_thres" value="$(arg camera_objects_conf_thres)"/>
    <param name="class_profile" value="$(arg camera_class_profile)"/>
  </node>
  </group>

  <node if="$(arg rviz)" name="sensor_fusion_rviz" pkg="rviz" type="rviz"
        args="-f map" output="screen"/>
</launch>
