<!-- Canonical ASMC bridge composition. All runtime nodes live in this package. -->
<launch>
  <arg name="runtime_profile" default="morai_udp"/>
  <arg name="transport_profile" default="local"/>
  <arg name="stream_profile" default="competition"/>
  <arg name="timestamp_mode" default="receive"/>
  <arg name="publish_map_tf" default="false"/>
  <arg name="lidar_frame_mode" default="azimuth"/>
  <arg name="cmd_ip" default="$(optenv MORAI_CMD_IP 127.0.0.1)"/>
  <arg name="cmd_port" default="9093"/>
  <arg name="competition_port" default="9798"/>
  <arg name="competition_status_required" default="false"/>
  <arg name="enable_vehicle_state" default="true"/>

  <include file="$(find asmc_bridge)/launch/morai_udp_bridges.launch">
    <arg name="runtime_profile" value="$(arg runtime_profile)"/>
    <arg name="transport_profile" value="$(arg transport_profile)"/>
    <arg name="stream_profile" value="$(arg stream_profile)"/>
    <arg name="timestamp_mode" value="$(arg timestamp_mode)"/>
    <arg name="publish_map_tf" value="$(arg publish_map_tf)"/>
    <arg name="lidar_frame_mode" value="$(arg lidar_frame_mode)"/>
    <arg name="cmd_ip" value="$(arg cmd_ip)"/>
    <arg name="cmd_port" value="$(arg cmd_port)"/>
    <arg name="competition_port" value="$(arg competition_port)"/>
    <arg name="competition_status_required" value="$(arg competition_status_required)"/>
  </include>

  <include if="$(arg enable_vehicle_state)"
           file="$(find asmc_bridge)/launch/vehicle_state.launch"/>
</launch>
