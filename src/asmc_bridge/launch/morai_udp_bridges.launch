<!--
  MORAI UDP ↔ ROS bridges (NOT rosbridge / WebSocket).

  - morai_udp_bridge    : Ego / Competition / Object / Collision / Ctrl_cmd
  - morai_sensor_bridge : Camera (+Semantic) / LiDAR / GPS / IMU

  Run: ./scripts/udp_bridge.sh
  Rosbridge (dev only): ./scripts/rosbridge.sh
-->
<launch>
  <!-- One runtime protocol for 26.R1.H3 and 25.S4.MolitComp03. -->
  <arg name="runtime_profile" default="morai_udp"/>
  <arg name="transport_profile" default="local"/>
  <!-- competition is fail-closed; development explicitly adds Object/GT. -->
  <arg name="stream_profile" default="competition"/>
  <arg name="enable_object" default="$(eval arg('stream_profile') == 'development')"/>
  <arg name="enable_semantic_camera" default="$(eval arg('stream_profile') == 'development')"/>
  <arg name="enable_instance_lidar" default="$(eval arg('stream_profile') == 'development')"/>
  <arg name="instance_lidar_port" default="9311"/>
  <arg name="instance_lidar_topic" default="/velodyne_points_instance"/>
  <arg name="timestamp_mode" default="receive"/>
  <!-- Opt-in only: authoritative localization must be the sole map TF owner. -->
  <arg name="publish_map_tf" default="false"/>
  <arg name="lidar_frame_mode" default="azimuth"/>
  <arg name="cmd_ip" default="$(optenv MORAI_CMD_IP 127.0.0.1)"/>
  <arg name="cmd_port" default="9093"/>
  <arg name="competition_port" default="9798"/>
  <arg name="competition_status_required" default="false"/>
  <include file="$(find asmc_bridge)/launch/morai_udp_bridge.launch">
    <arg name="runtime_profile" value="$(arg runtime_profile)"/>
    <arg name="transport_profile" value="$(arg transport_profile)"/>
    <arg name="stream_profile" value="$(arg stream_profile)"/>
    <arg name="enable_object" value="$(arg enable_object)"/>
    <arg name="cmd_ip" value="$(arg cmd_ip)"/>
    <arg name="cmd_port" value="$(arg cmd_port)"/>
    <arg name="competition_port" value="$(arg competition_port)"/>
    <arg name="competition_status_required" value="$(arg competition_status_required)"/>
    <arg name="timestamp_mode" value="$(arg timestamp_mode)"/>
  </include>
  <include file="$(find asmc_bridge)/launch/morai_sensor_bridge.launch">
    <arg name="runtime_profile" value="$(arg runtime_profile)"/>
    <arg name="transport_profile" value="$(arg transport_profile)"/>
    <arg name="stream_profile" value="$(arg stream_profile)"/>
    <arg name="enable_semantic_camera" value="$(arg enable_semantic_camera)"/>
    <arg name="enable_instance_lidar" value="$(arg enable_instance_lidar)"/>
    <arg name="instance_lidar_port" value="$(arg instance_lidar_port)"/>
    <arg name="instance_lidar_topic" value="$(arg instance_lidar_topic)"/>
    <arg name="timestamp_mode" value="$(arg timestamp_mode)"/>
    <arg name="publish_map_tf" value="$(arg publish_map_tf)"/>
    <arg name="lidar_frame_mode" value="$(arg lidar_frame_mode)"/>
  </include>
</launch>
