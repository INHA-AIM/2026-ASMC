<launch>
  <!-- Competition source. There is no EgoVehicleStatus fallback. -->
  <node pkg="asmc_bridge" type="vehicle_state_node"
        name="gps_imu_vehicle_state_adapter" output="screen">
    <rosparam command="load"
              file="$(find asmc_bridge)/config/vehicle_state.yaml"/>
  </node>
</launch>
