<launch>
  <!-- Shared packet/runtime profile for supported MORAI simulator releases. -->
  <arg name="runtime_profile" default="morai_udp"/>
  <arg name="transport_profile" default="local"/>
  <arg name="stream_profile" default="competition"/>
  <arg name="enable_ego_status" default="true"/>
  <arg name="enable_competition_status" default="$(eval arg('transport_profile') == 'local')"/>
  <arg name="competition_status_required" default="false"/>
  <arg name="enable_object" default="$(eval arg('stream_profile') == 'development')"/>
  <arg name="enable_collision" default="true"/>
  <!-- AIM06 스크린샷 기준 포트 (사람마다 Cmd/일부 포트 다름) -->
  <arg name="ego_port"       default="9099"/>   <!-- MolitComp03 CompetitionInfoPublisher, legacy ROS alias -->
  <arg name="competition_port" default="9798"/> <!-- Legacy local Detail diagnostic endpoint -->
  <arg name="object_port"    default="7505"/>   <!-- Object Info Dest -->
  <arg name="collision_port" default="9092"/>   <!-- Collision Data Dest -->
  <arg name="cmd_ip"         default="127.0.0.1"/>
  <arg name="cmd_port"       default="9093"/>   <!-- Ego Ctrl Cmd Host (SIM listen) -->
  <arg name="max_steer_deg"  default="40.0"/>
  <arg name="invert_steer" default="false" doc="Preserve team default; current AIM06 R1.H3 requires true, verified against vehicle yaw"/>
  <arg name="timestamp_mode" default="receive"/>

  <node pkg="asmc_bridge" type="morai_udp_bridge.py"
        name="morai_udp_bridge" output="screen">
    <rosparam command="load" file="$(find asmc_bridge)/config/diagnostics.yaml"/>
    <param name="runtime_profile" value="$(arg runtime_profile)"/>
    <param name="transport_profile" value="$(arg transport_profile)"/>
    <param name="stream_profile" value="$(arg stream_profile)"/>
    <param name="enable_ego_status" value="$(arg enable_ego_status)"/>
    <param name="enable_competition_status" value="$(arg enable_competition_status)"/>
    <param name="competition_status_required" value="$(arg competition_status_required)"/>
    <param name="enable_object" value="$(arg enable_object)"/>
    <param name="enable_collision" value="$(arg enable_collision)"/>
    <param name="ego_port"           value="$(arg ego_port)"/>
    <param name="competition_port"   value="$(arg competition_port)"/>
    <param name="object_port"        value="$(arg object_port)"/>
    <param name="collision_port"     value="$(arg collision_port)"/>
    <param name="cmd_ip"             value="$(arg cmd_ip)"/>
    <param name="cmd_port"           value="$(arg cmd_port)"/>
    <param name="max_steer_deg"      value="$(arg max_steer_deg)"/>
    <param name="timestamp_mode"     value="$(arg timestamp_mode)"/>
    <param name="cmd_payload_bytes"  value="23"/>
    <!-- Sign is verified for the actual simulator/vehicle/transport. Current
         AIM06 R1.H3 uses true; do not also reverse MPC or camera follower signs. -->
    <param name="invert_steer"       value="$(arg invert_steer)"/>
    <param name="ego_velocity_in_ms" value="true"/>
    <param name="frame_id"           value="base_link"/>
  </node>
</launch>
