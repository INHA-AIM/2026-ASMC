<launch>
  <arg name="state_topic" default="/vehicle/state"/>
  <node pkg="mpc_controller" type="mpc_controller_node"
        name="mpc_controller" output="screen">
    <rosparam command="load"
              file="$(find mpc_controller)/config/runtime.yaml"/>
    <param name="topics/vehicle_state" value="$(arg state_topic)"/>
    <param name="mpc/config_path"
           value="$(find mpc_controller)/config/mpc_params.yaml"/>
  </node>
</launch>
