<launch>
  <!-- Deterministic one-frame-at-a-time P4-C2 replay. This is an audit launch,
       not a deployment component. -->
  <arg name="bag_path"/>
  <arg name="report_path" default="/tmp/perception_traffic_light_parity_v1.yaml"/>
  <arg name="bag_topic" default="/cam_extra/image_jpeg/compressed"/>
  <arg name="sample_count" default="24"/>
  <arg name="stale_sec" default="1.0"/>
  <arg name="output_timeout_sec" default="5.0"/>
  <arg name="checkpoint" default="$(find traffic_light)/best.pt"/>
  <arg name="device" default="auto"/>

  <arg name="reference_input_topic"
       default="/asmc_perception/audit/reference/input/compressed"/>
  <arg name="canonical_input_topic"
       default="/asmc_perception/audit/canonical/input/compressed"/>
  <arg name="reference_state_topic"
       default="/asmc_perception/audit/reference/state"/>
  <arg name="reference_detail_topic"
       default="/asmc_perception/audit/reference/detail"/>
  <arg name="canonical_state_topic"
       default="/asmc_perception/audit/canonical/state"/>
  <arg name="canonical_detail_topic"
       default="/asmc_perception/audit/canonical/detail"/>
  <arg name="typed_topic"
       default="/asmc_perception/audit/canonical/detection"/>

  <node pkg="traffic_light" type="live_infer.py"
        name="traffic_light_reference" output="screen" required="true"
        args="--ckpt $(arg checkpoint) --image-topic $(arg reference_input_topic) --state-topic $(arg reference_state_topic) --detail-topic $(arg reference_detail_topic) --device $(arg device) --hz 30.0 --wait-first 0 --stale-sec $(arg stale_sec)"/>

  <node pkg="asmc_perception" type="traffic_light_node.py"
        name="traffic_light_canonical" output="screen" required="true"
        args="--ckpt $(arg checkpoint) --image-topic $(arg canonical_input_topic) --state-topic $(arg canonical_state_topic) --detail-topic $(arg canonical_detail_topic) --typed-topic $(arg typed_topic) --device $(arg device) --hz 30.0 --wait-first 0 --stale-sec $(arg stale_sec)"/>

  <node pkg="asmc_perception" type="traffic_light_parity_audit.py"
        name="traffic_light_parity_audit" output="screen" required="true">
    <param name="bag_path" value="$(arg bag_path)"/>
    <param name="bag_topic" value="$(arg bag_topic)"/>
    <param name="report_path" value="$(arg report_path)"/>
    <param name="sample_count" value="$(arg sample_count)"/>
    <param name="stale_timeout_sec" value="$(arg stale_sec)"/>
    <param name="output_timeout_sec" value="$(arg output_timeout_sec)"/>
    <param name="checkpoint_path" value="$(arg checkpoint)"/>
    <param name="reference_input_topic" value="$(arg reference_input_topic)"/>
    <param name="canonical_input_topic" value="$(arg canonical_input_topic)"/>
    <param name="reference_state_topic" value="$(arg reference_state_topic)"/>
    <param name="reference_detail_topic" value="$(arg reference_detail_topic)"/>
    <param name="canonical_state_topic" value="$(arg canonical_state_topic)"/>
    <param name="canonical_detail_topic" value="$(arg canonical_detail_topic)"/>
    <param name="typed_topic" value="$(arg typed_topic)"/>
  </node>
</launch>
