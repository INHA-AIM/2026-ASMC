<launch>
  <!-- Headless debug publishers. Open their compressed topics with
       rqt_image_view from the GUI-capable ROS container. -->
  <arg name="camera_calibration_config"
       default="$(find asmc_perception)/config/cameras_v3.yaml"/>
  <arg name="bev_grid_config"
       default="$(find drivable_bev)/config/bev_grid.yaml"/>
  <arg name="secondary_mode" default="road_marking"/>
  <arg name="publish_per_view_bev" default="false"/>

  <include file="$(find camera_semantic_perception)/launch/three_view_visualizer.launch">
    <arg name="secondary_mode" value="$(arg secondary_mode)"/>
  </include>

  <node pkg="drivable_bev" type="camera_bev_visualizer_node.py"
        name="camera_bev_visualizer" output="screen" required="true">
    <rosparam command="load" file="$(arg bev_grid_config)"/>
    <rosparam command="load" file="$(arg camera_calibration_config)"/>
    <rosparam command="load" file="$(find drivable_bev)/config/visualization.yaml"/>
    <rosparam param="enabled_views">[front, left, right]</rosparam>
    <param name="publish_per_view_mosaic" value="$(arg publish_per_view_bev)"/>
  </node>

  <node pkg="drivable_bev" type="lane_vector_visualizer_node.py"
        name="camera_lane_vector_visualizer" output="screen" required="true">
    <rosparam command="load" file="$(arg bev_grid_config)"/>
    <rosparam command="load" file="$(arg camera_calibration_config)"/>
    <rosparam command="load" file="$(find drivable_bev)/config/visualization.yaml"/>
  </node>
</launch>
