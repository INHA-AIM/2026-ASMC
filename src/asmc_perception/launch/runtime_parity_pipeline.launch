<launch>
  <!-- P4-C5 representative-bag parity harness. The raw bag is replayed below
       /p4c5_input so a live bridge cannot contaminate the comparison. -->
  <arg name="variant" default="canonical"/>
  <arg name="checkpoint"
       default="$(find asmc_perception)/../../artifacts/perception_eval/runs/twinlite_medium_morai_v6_road_marking_init_b_b12_e18_20260908/best_mean.pt"/>
  <arg name="sensor_set_path"
       default="$(find asmc_perception)/../../config/morai/sensors/ASMC_sensor_set_v2.json"/>
  <arg name="camera_calibration_config"
       default="$(find asmc_perception)/config/bev/cameras_v2.yaml"/>

  <group>
    <remap from="/image_jpeg/compressed"
           to="/p4c5_input/image_jpeg/compressed"/>
    <remap from="/cam_left/image_jpeg/compressed"
           to="/p4c5_input/cam_left/image_jpeg/compressed"/>
    <remap from="/cam_right/image_jpeg/compressed"
           to="/p4c5_input/cam_right/image_jpeg/compressed"/>

    <include if="$(eval arg('variant') == 'canonical')"
             file="$(find asmc_perception)/launch/perception.launch">
      <arg name="start_camera_lane" value="true"/>
      <arg name="start_traffic_light" value="false"/>
      <arg name="start_lidar_fusion" value="false"/>
      <arg name="start_recorder" value="false"/>
      <arg name="start_visualization" value="false"/>
      <arg name="camera_checkpoint" value="$(arg checkpoint)"/>
      <arg name="camera_sensor_set_path" value="$(arg sensor_set_path)"/>
      <arg name="camera_calibration_config"
           value="$(arg camera_calibration_config)"/>
    </include>

    <include if="$(eval arg('variant') == 'compatibility')"
             file="$(find drivable_bev)/launch/three_view_lane_pipeline.launch">
      <arg name="checkpoint" value="$(arg checkpoint)"/>
      <!-- The provenance SHA is part of the lane output contract, so the two
           paths use the same immutable v2 snapshot for this parity harness. -->
      <arg name="sensor_set_path" value="$(arg sensor_set_path)"/>
    </include>
  </group>
</launch>
