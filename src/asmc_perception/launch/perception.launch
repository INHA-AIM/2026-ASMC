<launch>
  <!-- P4-C6 canonical entrypoint. Camera/BEV/lane and traffic-light runtime,
       offline/training support, models and config are owned by asmc_perception.
       Topics/nodes are unchanged; LiDAR/fusion and data collection remain independent. -->
  <arg name="start_camera_lane" default="true"/>
  <arg name="start_traffic_light" default="false"/>
  <arg name="start_visualization" default="false"/>
  <arg name="visualization_legacy_rqt" default="false"/>
  <arg name="visualization_calibration_grid" default="false"/>
  <arg name="publish_bev_debug_metadata"
       default="$(arg visualization_legacy_rqt)"/>

  <arg name="camera_checkpoint"
       default="$(find asmc_perception)/../../artifacts/perception_eval/runs/twinlite_medium_morai_v6_road_marking_init_b_b12_e18_20260908/best_mean.pt"/>
  <arg name="camera_device" default="cuda"/>
  <arg name="camera_warmup_iterations" default="1"/>
  <arg name="camera_batch_wait_ms" default="20.0"/>
  <arg name="camera_model_grid_max_hz" default="15.0"/>
  <arg name="camera_sensor_set_path"
       default="$(find asmc_perception)/../../config/morai/sensors/ASMC_sensor_set_v3.json"/>
  <arg name="camera_calibration_config"
       default="$(find asmc_perception)/config/cameras_v3.yaml"/>
  <arg name="bev_grid_config"
       default="$(find asmc_perception)/config/bev/bev_grid.yaml"/>
  <arg name="lane_operating_domain" default="shadow_two_way_v1"/>
  <arg name="lane_algorithm_id" default="twinlite_v6_shadow_boundary_contract_v1"/>
  <arg name="lane_enable_shared_family_debug" default="false"/>
  <arg name="lane_enable_boundary_family_candidate"
       default="$(arg lane_enable_shared_family_debug)"/>
  <arg name="lane_publish_pipeline_audit" default="false"/>

  <arg name="traffic_light_checkpoint"
       default="$(find asmc_perception)/models/traffic_light/best.pt"/>
  <arg name="traffic_light_device" default="auto"/>
  <arg name="traffic_light_image_topic" default="/cam_extra/image_jpeg/compressed"/>
  <arg name="traffic_light_state_topic" default="/traffic_light/state"/>
  <arg name="traffic_light_detail_topic" default="/traffic_light/detail"/>
  <arg name="traffic_light_typed_topic"
       default="/perception/traffic_light/detection"/>
  <arg name="traffic_light_hz" default="10.0"/>
  <arg name="traffic_light_min_detect" default="0.40"/>
  <arg name="traffic_light_stale_sec" default="1.0"/>

  <group if="$(arg start_camera_lane)">
    <include file="$(find asmc_perception)/launch/camera_lane.launch">
      <arg name="checkpoint" value="$(arg camera_checkpoint)"/>
      <arg name="device" value="$(arg camera_device)"/>
      <arg name="warmup_iterations" value="$(arg camera_warmup_iterations)"/>
      <arg name="batch_wait_ms" value="$(arg camera_batch_wait_ms)"/>
      <arg name="publish_model_grid_road_marking" value="true"/>
      <arg name="model_grid_max_hz" value="$(arg camera_model_grid_max_hz)"/>
    </include>

    <node pkg="asmc_perception" type="camera_bev_node.py"
          name="camera_bev" output="screen" required="true">
      <rosparam command="load" file="$(arg bev_grid_config)"/>
      <rosparam command="load" file="$(arg camera_calibration_config)"/>
      <rosparam param="enabled_views">[front, left, right]</rosparam>
      <param name="verify_sensor_set" value="true"/>
      <param name="sensor_set_path" value="$(arg camera_sensor_set_path)"/>
      <param name="publish_coverage" value="$(arg publish_bev_debug_metadata)"/>
    </node>

    <node pkg="asmc_perception" type="camera_bev_fusion_node.py"
          name="camera_bev_fusion" output="screen" required="true">
      <rosparam command="load" file="$(arg bev_grid_config)"/>
      <rosparam command="load" file="$(arg camera_calibration_config)"/>
      <rosparam command="load" file="$(find asmc_perception)/config/bev/fusion.yaml"/>
      <rosparam param="views">[front, left, right]</rosparam>
      <param name="publish_debug_metadata"
             value="$(arg publish_bev_debug_metadata)"/>
    </node>

    <node pkg="asmc_perception" type="lane_vectorizer_node.py"
          name="camera_lane_vectorizer" output="screen" required="true">
      <rosparam command="load" file="$(arg camera_calibration_config)"/>
      <rosparam command="load" file="$(find asmc_perception)/config/bev/lane_fitting.yaml"/>
      <rosparam param="views">[front, left, right]</rosparam>
      <param name="operating_domain" value="$(arg lane_operating_domain)"/>
      <param name="algorithm_id" value="$(arg lane_algorithm_id)"/>
      <param name="shared_lane_family/runtime_debug_enabled"
             value="$(arg lane_enable_shared_family_debug)"/>
      <param name="enable_boundary_family_candidate"
             value="$(arg lane_enable_boundary_family_candidate)"/>
      <param name="publish_pipeline_audit"
             value="$(arg lane_publish_pipeline_audit)"/>
    </node>
  </group>

  <group if="$(arg start_traffic_light)">
    <!-- P4-C1 preserves both legacy String topics while publishing the exact
         source-image header on the typed result. -->
    <node pkg="asmc_perception" type="traffic_light_node.py" name="traffic_light_infer"
          output="screen" required="true"
          args="--ckpt $(arg traffic_light_checkpoint) --image-topic $(arg traffic_light_image_topic) --state-topic $(arg traffic_light_state_topic) --detail-topic $(arg traffic_light_detail_topic) --typed-topic $(arg traffic_light_typed_topic) --device $(arg traffic_light_device) --hz $(arg traffic_light_hz) --min-detect $(arg traffic_light_min_detect) --stale-sec $(arg traffic_light_stale_sec)"/>
  </group>

  <group if="$(arg start_visualization)">
    <include file="$(find asmc_perception)/launch/visualization.launch">
      <arg name="camera_calibration_config" value="$(arg camera_calibration_config)"/>
      <arg name="bev_grid_config" value="$(arg bev_grid_config)"/>
      <arg name="legacy_rqt" value="$(arg visualization_legacy_rqt)"/>
      <arg name="calibration_grid" value="$(arg visualization_calibration_grid)"/>
    </include>
  </group>

</launch>
