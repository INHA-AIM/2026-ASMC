<?xml version="1.0"?>
<package format="2">
  <name>asmc_perception</name>
  <version>0.1.0</version>
  <description>Canonical launch and interface facade for ASMC perception runtime components.</description>

  <maintainer email="autonav@todo.todo">autonav</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>asmc_msgs</depend>
  <depend>rospy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>

  <exec_depend>camera_semantic_perception</exec_depend>
  <exec_depend>data_collection</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>drivable_bev</exec_depend>
  <exec_depend>traffic_light</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>

  <test_depend>python3-nose</test_depend>
  <test_depend>python3-yaml</test_depend>

  <export/>
</package>
