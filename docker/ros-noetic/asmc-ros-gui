#!/usr/bin/env bash
# Stable Qt/ROS GUI launcher for Docker Desktop + WSLg/X11.
set -euo pipefail

# Sourced catkin setup scripts inspect the caller's positional parameters.
# Preserve GUI arguments so options such as --help or RViz flags cannot be
# mistaken for catkin setup options.
asmc_gui_args=("$@")
set --
source /opt/ros/noetic/setup.bash
if [[ -f /root/ws/devel/setup.bash ]]; then
  source /root/ws/devel/setup.bash
fi
set -- "${asmc_gui_args[@]}"

export XDG_RUNTIME_DIR=/tmp/asmc-xdg-runtime
export QT_X11_NO_MITSHM=1
export XCURSOR_PATH=/usr/share/icons
export XCURSOR_THEME=DMZ-White
install -d -m 700 "$XDG_RUNTIME_DIR"

usage() {
  cat <<'EOF'
Usage:
  asmc-ros-gui rqt-image [base-image-topic]
  asmc-ros-gui rviz [rviz options]

rqt-image selects the published /compressed topic in the image-view dropdown.
It waits up to 30 seconds for that topic before opening the window.
Both modes use a fresh Qt settings directory so stale multi-monitor geometry
cannot place the window off-screen. User RViz .rviz files are not modified.
EOF
}

mode="${1:-}"
if [[ -z "$mode" ]]; then
  usage
  exit 2
fi
shift

case "$mode" in
  rqt-image)
    export XDG_CONFIG_HOME
    XDG_CONFIG_HOME="$(mktemp -d /tmp/asmc-rqt-image.XXXXXX)"
    if [[ $# -eq 0 ]]; then
      exec rqt_image_view --clear-config
    fi
    topic="${1%/compressed}/compressed"
    shift
    # rqt_image_view chooses transport from its topic dropdown. A private
    # _image_transport parameter does not select that dropdown's transport.
    # Wait for registration so it maps this label to the compressed transport
    # instead of adding an unknown label as a raw Image topic.
    python3 - "$topic" <<'PY'
import sys
import time
import rosgraph

topic = sys.argv[1]
master = rosgraph.Master('/asmc_ros_gui_launcher')
deadline = time.monotonic() + 30.0
while time.monotonic() < deadline:
    try:
        topics = dict(master.getPublishedTopics('/'))
        if topics.get(topic) == 'sensor_msgs/CompressedImage':
            break
    except (OSError, rosgraph.MasterException):
        pass
    time.sleep(0.25)
else:
    sys.exit('No sensor_msgs/CompressedImage publisher for ' + topic + ' within 30s')
PY
    exec rqt_image_view --clear-config "$topic" "$@"
    ;;
  rviz)
    export XDG_CONFIG_HOME
    XDG_CONFIG_HOME="$(mktemp -d /tmp/asmc-rviz.XXXXXX)"
    exec rviz "$@"
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    echo "Unknown GUI mode: $mode" >&2
    usage >&2
    exit 2
    ;;
esac
