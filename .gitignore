# Perception eval artifacts (bake · runs · galleries)
artifacts/perception_eval/runs/
artifacts/perception_eval/bake/
artifacts/perception_eval/poses_noisy/
artifacts/perception_eval/jobs/

# Large, reproducible BEV/lane debug payloads stay local.  Curated metrics and
# metadata may still be committed from each analysis directory.
artifacts/perception_eval/analysis/*/overlays/
artifacts/perception_eval/analysis/*/range_inputs.npz
artifacts/perception_eval/analysis/*/metrics.json
artifacts/perception_eval/analysis/*/metrics_by_bin.csv
artifacts/perception_eval/analysis/*/frame_metrics.csv
artifacts/perception_eval/analysis/*/manual_review.csv
# Raw roslaunch/recorder logs are reproducible and frequently contain terminal
# formatting whitespace. Keep the normalized YAML/JSON audit summaries instead.
artifacts/perception_eval/analysis/**/*batch_summary_logs/

# Superseded parameter sweeps are preserved locally but are not PR artifacts.
artifacts/perception_eval/analysis/twinlite_v6_bev_loss_budget_20260910/
