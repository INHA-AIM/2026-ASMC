# Deterministically generated HD-map artifacts are kept for runtime and
# provenance, but GitHub should collapse their very large diffs by default.
src/asmc_hd_map/reports/** linguist-generated=true
src/asmc_hd_map/config/kcity2025_compact_drivable_map.json linguist-generated=true
src/asmc_hd_map/config/*.npz binary
src/asmc_hd_map/**/*.png binary
src/asmc_hd_map/**/*.h5 binary

# MORAI UI exports use CRLF on Windows. Preserve their importable source bytes
# and treat CR as part of the line ending when Git checks whitespace.
config/morai/**/*.json whitespace=cr-at-eol
# Preserve organizer map bytes (including CRLF) for frozen SHA256 provenance.
src/asmc_planner/config/behavior/link_set.json -text whitespace=cr-at-eol
src/asmc_planner/config/behavior/node_set.json -text whitespace=cr-at-eol
src/asmc_planner/config/behavior/global_info.json -text whitespace=cr-at-eol
