<launch>
  <!-- Model settings and GPU Python remain owned by asmc_camera. -->
  <include file="$(find asmc_camera)/launch/camera.launch">
    <arg name="mode" value="active"/>
  </include>
  <include file="$(find asmc_lidar)/launch/lidar.launch">
    <arg name="rviz" value="false"/>
  </include>
</launch>
