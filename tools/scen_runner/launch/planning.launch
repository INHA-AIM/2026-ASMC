<launch>
  <!-- All nodes here are restarted together while ego is held at its spawn. -->
  <include file="$(find planning_inputs)/launch/vehicle_state.launch"/>
  <include file="$(find planning_inputs)/launch/objects.launch"/>
  <include file="$(find asmc_planner)/launch/planner_v2.launch">
    <arg name="state_topic" value="/planning/vehicle/state"/>
    <arg name="objects_input_type" value="detected"/>
    <arg name="behavior_objects_topic" value="/planning/objects"/>
    <arg name="planning_objects_topic" value="/planning/objects"/>
  </include>
  <include file="$(find asmc_controller)/launch/controller.launch">
    <arg name="state_topic" value="/planning/vehicle/state"/>
  </include>
  <node pkg="asmc_planner" type="asmc_control_selector_node"
        name="asmc_control_selector" output="screen" required="true"/>
  <include file="$(find lane_boundary_adapter)/launch/camera_bbox_lane_change.launch">
    <arg name="enable_control" value="true"/>
    <arg name="control_topic" value="/ctrl_cmd/jamming"/>
    <arg name="use_rviz" value="false"/>
  </include>
  <!-- Reuse the front-camera YOLO result already forwarded by Main. -->
  <param name="/camera_bbox_frame_bridge/bbox_topic" value="/YOLO/BBox"/>
</launch>
