<launch>
  <!-- Use the same state source, shadow-zone handoff and avoidance settings
       as the ordinary D command. The supervisor still owns/restarts this group. -->
  <include file="$(find asmc_planner)/launch/autonomy_no_bridges_v2.launch">
    <arg name="dashboard" value="false"/>
    <arg name="rviz" value="false"/>
  </include>
</launch>
