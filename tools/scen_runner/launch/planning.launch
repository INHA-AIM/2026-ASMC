<launch>
  <!-- All nodes here are restarted together while ego is held at its spawn. -->
  <include file="$(find planning_inputs)/launch/vehicle_state.launch"/>
  <include file="$(find planning_inputs)/launch/objects.launch">
  </include>
  <include file="$(find asmc_planner)/launch/planner_v2.launch">
    <arg name="state_topic" value="/planning/vehicle/state"/>
    <arg name="objects_input_type" value="detected"/>
    <arg name="behavior_objects_topic" value="/planning/objects"/>
    <arg name="planning_objects_topic" value="/planning/objects"/>
  </include>
  <include file="$(find asmc_controller)/launch/controller.launch">
    <arg name="state_topic" value="/planning/vehicle/state"/>
  </include>
  <node pkg="asmc_planner" type="asmc_control_selector_node"
        name="asmc_control_selector" output="screen" required="true"/>
  <include file="$(find lane_boundary_adapter)/launch/camera_bbox_lane_change.launch">
    <arg name="enable_control" value="true"/>
    <arg name="control_topic" value="/ctrl_cmd/jamming"/>
    <arg name="use_rviz" value="false"/>
  </include>
  <param name="camera_bbox_lane_change/contact_clearance_enabled" value="$(optenv ASMC_SHADOW_CONTACT_CLEARANCE false)" type="bool"/>
  <param name="camera_bbox_lane_change/contact_local_required" value="$(optenv ASMC_SHADOW_LOCAL_CONTACT false)" type="bool"/>
  <param name="camera_bbox_lane/local_contact_support_enabled" value="$(optenv ASMC_SHADOW_LOCAL_CONTACT false)" type="bool"/>
  <!-- Experimental path sees the family provider's available 15-20 m range.
       Runtime still intersects actual contiguous support and full-body coverage;
       this does not extrapolate a short family to 20 m. Legacy remains 15/11 m. -->
  <group if="$(optenv ASMC_SHADOW_CONTACT_CLEARANCE false)">
    <param name="camera_bbox_lane_change/consumer_x_max" value="20.0" type="double"/>
    <param name="camera_bbox_lane_change/path_horizon" value="15.0" type="double"/>
    <param name="camera_bbox_lane_change/contact_preferred_margin" value="0.15" type="double"/>
  </group>
  <!-- Trial-only preparation: the existing final arbitration cap applies to
       KEEP/FOLLOW/AVOID alike. A normal_cruise link cap is insufficient when a
       visible obstacle selects another behavior. GPS ownership stays unchanged. -->
  <group if="$(optenv ASMC_SHADOW_APPROACH_CAP false)">
    <param name="behavior_planner/maximum_speed_kph" value="5.0" type="double"/>
  </group>
  <!-- The camera frame bridge consumes asmc_camera directly, independently of Main. -->
</launch>
