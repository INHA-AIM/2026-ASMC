<launch>
  <arg name="fusion_trace_path" default=""/>
  <arg name="fusion_yolo_policy" default="unique"/>
  <!-- Existing Main ParseCAN publishes a legacy control stub even in
       perception-only mode. Quarantine it in the test master only. -->
  <group>
    <remap from="/ctrl_cmd_0" to="/b0/discarded_ctrl_cmd_0"/>
    <remap from="/ctrl_cmd" to="/b0/discarded_ctrl_cmd"/>
    <include file="$(find Main)/main.launch">
      <arg name="start_yolo" value="false"/>
      <arg name="rviz" value="false"/>
      <arg name="start_velodyne_driver" value="false"/>
      <arg name="fusion_trace_path" value="$(arg fusion_trace_path)"/>
      <arg name="fusion_yolo_policy" value="$(arg fusion_yolo_policy)"/>
    </include>
  </group>
</launch>
